---
import type {CollectionEntry} from 'astro:content';
import {supportingCompetencies} from '../../lib/content/model';
import {evidenceHref} from '../../lib/content/expertise';
import type {GraphEntry} from '../../lib/content/model';
interface Props {entry:CollectionEntry<'publications'>;catalog:GraphEntry[];}
const {entry,catalog}=Astro.props;
const d=entry.data;
const related=supportingCompetencies(catalog,d.id);
const dateLabel=new Date(d.onlineDate+'T00:00:00Z').toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
const citeParts=[d.venue,d.volume+(d.issue?'('+d.issue+')':''),d.pages??d.articleNumber].filter(Boolean);
---
<article id={d.id.toLowerCase()} data-publication-id={d.id} class="border border-structural p-5 md:p-7 publication-record">
 <p class="technical-label">{d.id} / {d.year} / {d.publicationType==='original-research'?'Original research':'Review article'} / {d.authorship==='first-author'?'First author':'Co-author'}</p>
 <h3 class="mt-3">{d.title}</h3>
 <p class="mt-4 leading-relaxed" data-publication-authors>
  {d.authors.map((name,i)=><>
    {i>0?', ':''}{name==='Yeabsra Mekdim Hailu'?<strong data-portfolio-author>{name}</strong>:name}
  </>)}
 </p>
 <p class="secondary-text mt-3 text-sm">{citeParts.join(', ')}</p>
 <p class="technical-caption mt-2">Published online {dateLabel}</p>
 <p class="mt-5">{d.summary}</p>
 <div class="border-t border-structural mt-5 pt-4">
  <p class="technical-caption">DOI: {d.doi}</p>
  <a href={'https://doi.org/'+d.doi} class="inline-flex min-h-11 min-w-11 items-center font-semibold mt-2">Read publication <span aria-hidden="true" class="ml-2">↗</span></a>
 </div>
 {related.length>0&&<div class="border-t border-structural mt-4 pt-3">
  <p class="technical-label">Related competencies</p>
  <ul class="flex flex-wrap gap-x-5 gap-y-1 mt-2" data-research-competencies>{related.map(comp=><li data-related-competency={comp.data.id}><a class="inline-flex min-h-11 items-center text-sm" href={evidenceHref(comp)}>{comp.data.title}</a></li>)}</ul>
 </div>}
</article>
<style>
 .publication-record{scroll-margin-top:24px}
</style>
