---
interface Props { entries:{decision:string;tradeoff:string}[]; }
const {entries}=Astro.props;
---
<figure class="my-6 border border-structural" data-tradeoffs>
 <table class="tradeoff-table">
  <caption class="technical-label text-left p-4">Typical engineering trade-offs</caption>
  <thead><tr><th scope="col">Design decision</th><th scope="col">Engineering trade-off</th></tr></thead>
  <tbody>{entries.map(item=><tr><th scope="row">{item.decision}</th><td>{item.tradeoff}</td></tr>)}</tbody>
 </table>
 <figcaption class="technical-caption p-4">These are general engineering considerations, not disclosures of decisions made on specific employer projects.</figcaption>
</figure>
<style>
 .tradeoff-table{width:100%;table-layout:fixed;border-collapse:collapse;font-size:.875rem;}
 .tradeoff-table th,.tradeoff-table td{padding:12px;vertical-align:top;text-align:left;overflow-wrap:anywhere;}
 .tradeoff-table thead th{background:var(--color-navy);color:var(--color-ivory);}
 .tradeoff-table th:first-child{width:42%}
 .tradeoff-table tbody tr{border-bottom:1px solid var(--color-structural)}
 .tradeoff-table tbody th{font-weight:600}
</style>
