---
import type { CollectionEntry } from 'astro:content';
import { displayDate } from '../../lib/profile';
interface Props { entries:CollectionEntry<'credentials'>[]; }
const {entries}=Astro.props;
---
<ul class="editorial-grid mt-8" aria-label="Education and professional credentials">
 {entries.map(({data:d})=><li class="span-half border border-structural p-5" id={d.id.toLowerCase()} data-credential-id={d.id}>
   <p class="technical-label">{d.category==='education'?'Education':'Professional certification'} · {displayDate(d.issued)}</p>
   <h3 class="mt-3">{d.title}</h3>
   <p class="mt-3 font-medium">{d.issuer}</p>
   {d.location&&<p class="secondary-text text-sm">{d.location}</p>}
   {d.summary!==d.title&&d.id==='CRED-001'&&<p class="secondary-text mt-3">{d.summary}</p>}
 </li>)}
</ul>
<p class="technical-caption mt-4">Qualifications and dates confirmed by the portfolio owner.</p>
