---
interface Props { kind: 'independent' | 'simulated' | 'development'; }
const {kind} = Astro.props;
const descriptions = {
  independent: {title:'Independent technical demonstration', text:'An original engineering work sample. It does not represent employer equipment or actual production results.'},
  simulated: {title:'Illustrative or simulated results', text:'Inputs are hypothetical or synthetic. Outputs are not actual employment accomplishments.'},
  development: {title:'Development specimen', text:'This page validates the application shell. Final professional content has not been approved for publication.'},
};
const item = descriptions[kind];
---
<aside class="border border-structural border-l-4 border-l-deep-teal p-4 reading-width" aria-label={item.title}>
  <p class="technical-label">{item.title}</p>
  <p class="secondary-text mt-2 text-sm">{item.text}</p>
</aside>
