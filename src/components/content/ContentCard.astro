---
import { routeHref } from '../../lib/site';
interface Props { title: string; description: string; route: string; category?: string; class?: string; }
const { title, description, route, category, class: className } = Astro.props;
---
<article class:list={['border border-structural p-5 flex flex-col gap-3 min-w-0', className]}>
  {category && <p class="technical-label">{category}</p>}
  <h3>{title}</h3>
  <p class="secondary-text">{description}</p>
  <a class="card-link mt-auto" href={routeHref(route)} aria-label={'Explore ' + title}>Explore <span aria-hidden="true">→</span></a>
</article>
<style>
  .card-link {display:inline-flex;align-items:center;gap:8px;min-height:44px;align-self:flex-start;font-weight:600;}
</style>
