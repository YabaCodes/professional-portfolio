---
import {calculateFactorOee,lossLabels,type OeeFactors} from '../../lib/engineering/oee-factors';
interface Props {example:{title:string;defaults:OeeFactors;disclosure:string;interpretation:string;status:string}}
const {example}=Astro.props;
const initial=calculateFactorOee(example.defaults);
const factors=['availability','performance','quality'] as const;
const fmt=(v:number)=>v.toFixed(2)+'%';
---
<section class="border border-structural p-5 my-6" aria-label={example.title} data-oee-example>
 <p class="technical-label">Independent engineering example / Synthetic inputs</p>
 <h3>{example.title}</h3>
 <p>Overall Equipment Effectiveness</p>
 <p class="secondary-text text-sm">Adjust the hypothetical performance factors.</p>
 <form data-oee-form>
  <fieldset disabled data-oee-controls>
   <legend class="sr-only">Hypothetical performance factors</legend>
   {factors.map(key=><div class="mb-3">
    <label class="flex justify-between gap-3 font-medium" for={'oee-factor-'+key}><span class="capitalize">{key}</span><span data-factor-value={key}>{example.defaults[key]}%</span></label>
    <input class="factor-slider" id={'oee-factor-'+key} name={key} type="range" min="0" max="100" step="1" value={example.defaults[key]} data-factor={key}/>
   </div>)}
   <button class="action-link" type="reset">Reset</button>
  </fieldset>
 </form>
 <noscript><p class="technical-caption">JavaScript is disabled; the default hypothetical scenario remains visible.</p></noscript>
 <div class="border-t border-structural mt-5 pt-5">
  <div role="status" aria-live="polite" aria-atomic="true">
   <p class="technical-label">Calculated OEE</p>
   <p class="font-display font-bold text-4xl text-deep-teal tabular-nums" data-oee-result>{fmt(initial.oee)}</p>
   <p>Largest loss category: <strong data-largest-loss>{initial.largestLoss}</strong></p>
  </div>
  <p class="font-technical text-sm">OEE = A × P × Q</p>
  <p class="technical-caption">A, P and Q are fractional factors (percentages divided by 100).</p>
  <div class="loss-bar" aria-hidden="true">{initial.losses.map((v,i)=><span data-loss-bar={i} style={`width:${v}%`}/>)}</div>
  <ul class="grid gap-3 mt-4" aria-label="Loss decomposition">
   {lossLabels.map((label,i)=><li class="flex justify-between gap-3 items-start"><span class="flex items-center gap-2"><span class="loss-key" data-loss-key={i} aria-hidden="true"/>{label}</span><span class="font-technical text-sm tabular-nums" data-loss-value={i}>{fmt(initial.losses[i])}</span></li>)}
  </ul>
  <p class="technical-caption mt-4">All loss contributions are expressed relative to planned production time.</p>
  <p class="technical-caption">{example.disclosure}</p>
  <p>{example.interpretation}</p>
  <p class="technical-caption">{example.status}</p>
 </div>
</section>
<script>
 import {calculateFactorOee,type OeeFactors} from '../../lib/engineering/oee-factors';
 for(const root of document.querySelectorAll<HTMLElement>('[data-oee-example]')){
  const form=root.querySelector<HTMLFormElement>('[data-oee-form]');
  const controls=root.querySelector<HTMLFieldSetElement>('[data-oee-controls]');
  if(!form||!controls)continue;
  const update=()=>{
   const data=new FormData(form);
   const factors:OeeFactors={availability:Number(data.get('availability')),performance:Number(data.get('performance')),quality:Number(data.get('quality'))};
   const result=calculateFactorOee(factors);
   for(const key of Object.keys(factors) as (keyof OeeFactors)[]){
    const label=root.querySelector(`[data-factor-value="${key}"]`);
    if(label)label.textContent=factors[key]+'%';
   }
   const output=root.querySelector('[data-oee-result]');
   const largest=root.querySelector('[data-largest-loss]');
   if(output)output.textContent=result.oee.toFixed(2)+'%';
   if(largest)largest.textContent=result.largestLoss;
   result.losses.forEach((v,i)=>{
    const bar=root.querySelector<HTMLElement>(`[data-loss-bar="${i}"]`);
    const value=root.querySelector(`[data-loss-value="${i}"]`);
    if(bar)bar.style.width=v+'%';
    if(value)value.textContent=v.toFixed(2)+'%';
   });
  };
  controls.disabled=false;
  form.addEventListener('input',update);
  form.addEventListener('reset',()=>queueMicrotask(update));
 }
</script>
<style>
 .factor-slider{display:block;width:100%;height:44px;accent-color:var(--color-deep-teal);cursor:pointer}
 .loss-bar{display:flex;height:24px;overflow:hidden;border:1px solid var(--color-structural)}
 .loss-bar span{display:block;height:100%}
 .loss-key{display:inline-block;width:12px;height:12px;flex-shrink:0}
 [data-loss-bar="0"],[data-loss-key="0"]{background:#A07A4D}
 [data-loss-bar="1"],[data-loss-key="1"]{background:#78909C}
 [data-loss-bar="2"],[data-loss-key="2"]{background:#A7A29B}
 [data-loss-bar="3"],[data-loss-key="3"]{background:var(--color-teal)}
</style>
