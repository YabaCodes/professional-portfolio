---
import type { CollectionEntry } from 'astro:content';
import { displayDate } from '../../lib/profile';
interface Props { career: CollectionEntry<'career'>[]; education: CollectionEntry<'credentials'>[]; }
const {career,education}=Astro.props;
const rows = [
 ...career.map(({data:d})=>({id:d.id,date:d.start,period:displayDate(d.start)+' — '+(d.end?displayDate(d.end):'Present'),title:d.role,organization:d.organization,detail:d.assignment?'Additional leadership assignment':d.location,summary:d.summary})),
 ...education.map(({data:d})=>({id:d.id,date:d.issued,period:d.issued,title:d.title,organization:d.issuer,detail:d.location,summary:undefined})),
].sort((a,b)=>b.date.localeCompare(a.date));
---
<ol class="timeline mt-8" aria-label="Professional journey">
 {rows.map(row=><li class="timeline-row" data-record-id={row.id}>
   <p class="technical-label">{row.period}</p>
   <div>
    <h3>{row.title}</h3>
    <p class="mt-2 font-medium">{row.organization}</p>
    {row.detail&&<p class="secondary-text text-sm">{row.detail}</p>}
    {row.summary&&<p class="secondary-text mt-3 reading-width">{row.summary}</p>}
   </div>
 </li>)}
</ol>
<style>
 .timeline {border-left:1px solid var(--color-structural);margin-left:6px;padding-left:20px;}
 .timeline-row {position:relative;display:grid;gap:8px;padding:0 0 32px;}
 .timeline-row:last-child{padding-bottom:0;}
 .timeline-row::before{content:'';position:absolute;width:9px;height:9px;background:var(--color-teal);border:2px solid var(--color-ivory);box-shadow:0 0 0 1px var(--color-teal);border-radius:50%;left:-25px;top:5px;}
 @media(min-width:768px){.timeline-row{grid-template-columns:10rem minmax(0,1fr);gap:24px;}}
</style>
