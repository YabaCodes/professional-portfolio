---
import type {CollectionEntry} from 'astro:content';
import {routeHref} from '../../lib/site';
import EvidenceLabel from './EvidenceLabel.astro';
import LatticeConcept from '../illustrations/LatticeConcept.astro';
import AssemblyConcept from '../illustrations/AssemblyConcept.astro';
interface Props { entries:CollectionEntry<'case-studies'>[]; headingLevel?:2|3; }
const {entries,headingLevel=3}=Astro.props;
const Heading=headingLevel===2?'h2':'h3';
---
{entries.length>0&&<div class="editorial-grid mt-8">
 {entries.map(({data:d})=><article class="span-half border border-structural p-5 min-w-0" data-case-id={d.id}>
  {d.illustration==='lattice'&&<LatticeConcept compact/>}
  {d.illustration==='system'&&<AssemblyConcept/>}
  <p class="technical-label mt-3">{d.id} / {d.pillar}</p>
  <Heading class="mt-3">{d.title}</Heading>
  <p class="secondary-text mt-3">{d.summary}</p>
  <div class="mt-4"><EvidenceLabel type={d.evidenceType}/></div>
  <a class="inline-flex min-h-11 items-center mt-4 font-medium" href={routeHref('work/'+d.slug)} aria-label={'Read case study: '+d.title}>Read case study <span aria-hidden="true">→</span></a>
 </article>)}
</div>}
