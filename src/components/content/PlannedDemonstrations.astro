---
interface Props { entries:{id:string;title:string;description:string}[]; }
const {entries}=Astro.props;
---
<div class="my-6" data-planned-tools>
 <p class="technical-label">Planned independent demonstrations — not implemented</p>
 <ul class="grid gap-3 mt-4">
  {entries.map(item=><li class="border border-structural p-4"><span class="technical-caption">{item.id}</span><h3 class="text-lg mt-2">{item.title}</h3><div class="secondary-text text-sm mt-2">{item.description}</div></li>)}
 </ul>
</div>
