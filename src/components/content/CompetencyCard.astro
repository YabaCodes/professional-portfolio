---
import type {GraphEntry} from '../../lib/content/model';
import {competencyAnchor,evidenceHref,evidenceDescription} from '../../lib/content/expertise';
import {routeHref} from '../../lib/site';
interface Props {entry:GraphEntry;evidence:GraphEntry[]}
const {entry,evidence}=Astro.props;
const d=entry.data;
const performanceCase=evidence.find(e=>e.data.id==='CS-002');
---
<article class="competency-card border border-structural p-5 min-w-0" id={competencyAnchor(d.id)} data-competency-id={d.id}>
 <p class="technical-label">{d.id}</p>
 <h3 class="mt-3">{d.title}</h3>
 <p class="secondary-text mt-3">{d.summary}</p>
 <div class="border-t border-structural mt-5 pt-4">
  <p class="technical-label">Supporting evidence</p>
  <ul class="grid gap-3 mt-2" aria-label={'Supporting evidence for '+d.title}>
   {evidence.map(item=><li data-evidence-id={item.data.id}>
    {evidenceHref(item)?<a class="evidence-link" href={evidenceHref(item)}>{item.data.title}</a>:<span class="font-medium">{item.data.title}</span>}
    <p class="technical-caption">{item.data.id} · {evidenceDescription(item)}</p>
   </li>)}
  </ul>
  {d.id==='COMP-010'&&performanceCase&&<div class="border-t border-structural mt-4 pt-3" data-embedded-example>
   <a class="evidence-link" href={routeHref('work/'+performanceCase.data.slug)+'#oee-example'}>Interactive OEE example</a>
   <p class="technical-caption">Independent analytical example · Implemented in CS-002</p>
   <p class="secondary-text text-sm mt-2">Synthetic performance factors and manufacturing loss decomposition.</p>
   <div class="border-t border-structural mt-4 pt-3" data-planned-evidence>
    <p class="font-medium text-sm">Manufacturing Performance &amp; OEE Analyzer</p>
    <p class="technical-caption">EL-001 · Planned Engineering Lab tool</p>
   </div>
  </div>}
 </div>
</article>
<style>
 .competency-card{scroll-margin-top:24px}
 .evidence-link{display:inline-flex;align-items:center;min-height:44px;min-width:44px;font-weight:600;font-size:.925rem;padding-block:6px}
</style>
