---
interface Props { example:{title:string;illustration:'positioning';objective:string;concepts:[{title:string;description:string},{title:string;description:string}];interpretation:string;disclosure:string}; }
const {example}=Astro.props;
---
<section class="border border-structural p-5 my-6" aria-label={example.title} data-independent-example>
 <p class="technical-label">Illustrative engineering scenario</p>
 <h3>{example.title}</h3>
 <div class="concepts mt-4">
  {example.concepts.map((concept,i)=><figure class="min-w-0">
   <svg viewBox="0 0 160 135" role="img" aria-label={i===0?'Rigid jaws constrain a generic component':'Spring symbols represent compliant positioning of a generic component'} focusable="false">
    <rect x="14" y="18" width="132" height="100" rx="3" fill="#CDD2CC" fill-opacity=".45" stroke="#52636A"/>
    <rect x="44" y="40" width="72" height="56" fill="#347D73" stroke="#286B62" rx="3"/>
    {i===0?<g fill="currentColor" fill-opacity=".55"><rect x="24" y="48" width="17" height="40"/><rect x="119" y="48" width="17" height="40"/><path d="M9 68H24M16 63L24 68 16 73M151 68H136M144 63L136 68 144 73" stroke="currentColor" fill="none" stroke-width="1.4"/></g>:<g fill="currentColor" fill-opacity=".55"><rect x="28" y="48" width="13" height="40"/><rect x="119" y="48" width="13" height="40"/><path d="M14 68H17L20 58 23 78 26 58 29 68 M146 68H143L140 58 137 78 134 58 131 68" stroke="#286B62" fill="none" stroke-width="1.6"/></g>}
    <path d="M80 8V128" stroke="currentColor" stroke-dasharray="4 4" opacity=".5"/>
   </svg>
   <figcaption><strong>{concept.title}</strong><span class="block secondary-text text-sm mt-2">{concept.description}</span></figcaption>
  </figure>)}
 </div>
 <div class="border-t border-structural mt-5 pt-4"><p class="font-semibold">Engineering objective</p><p>{example.objective}</p></div>
 <p class="technical-caption">{example.disclosure}</p>
 {example.interpretation.split('\n\n').map(p=><p>{p}</p>)}
</section>
<style>
 .concepts{display:grid;grid-template-columns:minmax(0,1fr);gap:20px;}
 @media(min-width:560px){.concepts{grid-template-columns:repeat(2,minmax(0,1fr));}}
 .concepts svg{display:block;width:100%;height:auto;max-width:220px;margin-inline:auto;}
</style>
