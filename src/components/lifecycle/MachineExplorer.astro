---
/**
 * Equipment layout, drawn from the owner's sketch: a typical automated assembly machine with a
 * closed-loop transfer system. Pallets start at the feeding station (tray loader, bowl feeder),
 * pass assembly stations that combine handling and assembly (2) with control and inspection (3)
 * or process monitoring (4), a reject exit, and final inspection and unloading (5, 6) to the
 * tray unloader and labeling (7); guarding with access doors is safety (8). Original, generic
 * schematic: no real machine, supplier or product. Selecting a topic highlights every element
 * that serves it. A wide drawing on larger screens, a vertical one on phones. JS-free first state.
 */
import { machine, phases, phaseShort } from '../../lib/portfolio';
const index = Object.fromEntries(phases.map((p, i) => [p.id, i]));
const pad = (n: number) => String(n + 1).padStart(2, '0');
const ids: string[] = machine.spots.map(s => s.id);  // position + 1 = number shown on the drawing
const topic = (n: number) => ids[n - 1];
const first = ids[0];
const on = (topics: string) => (topics.split(' ').includes(first) ? ' is-active' : '');
// Stations in flow order: numbers are the topics each station serves.
const stations = [[1], [2, 3], [2, 4], [2, 3], [2, 4], [2, 3], [2, 4], [5, 6]];
const topicsOf = (nums: number[]) => nums.map(topic).join(' ');
// Wide: top run left to right (S1-S4), bottom run right to left (S5-S8).
const wide = stations.map((nums, i) => ({ nums, x: i < 4 ? 190 + i * 94 : 190 + (7 - i) * 94, y: i < 4 ? 56 : 180, w: 84, h: 56 }));
// Tall: right column top to bottom (S1-S4), left column bottom to top (S5-S8).
const tall = stations.map((nums, i) => ({ nums, x: i < 4 ? 236 : 106, y: i < 4 ? 130 + i * 100 : 130 + (7 - i) * 100, w: 58, h: 70 }));
type Station = { nums: number[]; x: number; y: number; w: number; h: number };
const minis = (s: Station, r: number) =>
  s.nums.map((n, k) => ({ n, id: topic(n), cx: s.x + s.w / 2 + (s.nums.length === 1 ? 0 : (k === 0 ? -1 : 1) * (r + 3)), cy: s.y + s.h / 2, r }));
const label = 'Schematic top view of an automated assembly machine with a closed-loop transfer system: a tray loader and a bowl feeder feed the first station; assembly stations combine handling and assembly with control and inspection or with process monitoring; one station rejects bad parts; the last station performs final inspection and unloading to a tray unloader, followed by labeling; guarding with access doors encloses the machine';
---
<div class="explorer" data-explorer>
  <figure class="explorer-figure">
    <!-- Wide drawing (tablet and desktop) -->
    <svg class="layout layout-wide" viewBox="0 0 720 296" role="img" aria-label={label}>
      <defs><marker id="arw-h" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L8 4L0 8z" class="arrow-head" /></marker></defs>
      <rect x="150" y="48" width="440" height="196" data-topics="safety" class={'guard' + on('safety')} />
      <path d="M590 96h30a30 30 0 0 1-30 30M590 166h30a30 30 0 0 1-30 30" data-topics="safety" class={'door' + on('safety')} />
      <g data-topics="safety" class={'mini' + on('safety')}><circle cx="590" cy="48" r="10" /><text x="590" y="51.5">8</text></g>
      <rect x="176" y="118" width="388" height="56" rx="28" class="track" />
      <rect x="190" y="132" width="360" height="28" rx="14" class="track-inner" />
      {Array.from({ length: 9 }, (_, k) => <rect x={200 + k * 40} y="121" width="12" height="9" rx="2" class="pallet" />)}
      {Array.from({ length: 9 }, (_, k) => <rect x={200 + k * 40} y="163" width="12" height="9" rx="2" class="pallet" />)}
      <path d="M382 121l6 4.5-6 4.5M398 163l-6 4.5 6 4.5" class="flow-arrow" />
      {wide.map(s => (
        <g data-topics={topicsOf(s.nums)} class={'st' + on(topicsOf(s.nums))}>
          <rect x={s.x} y={s.y} width={s.w} height={s.h} rx="4" class="box" />
          {minis(s, 11).map(m => <g data-topics={m.id} class={'mini' + on(m.id)}><circle cx={m.cx} cy={m.cy} r={m.r} /><text x={m.cx} y={m.cy + 3.5}>{m.n}</text></g>)}
        </g>
      ))}
      <g data-topics="feeding" class={'ext' + on('feeding')}>
        <rect x="30" y="40" width="90" height="30" rx="4" class="box" /><text x="75" y="59" class="label">Tray loader</text>
        <circle cx="75" cy="104" r="16" class="box" /><path d="M66 104a9 9 0 0 1 18 0" class="thin" />
        <text x="75" y="135" class="label small">Bowl feeder</text>
        <path d="M120 55H170V76H188M91 104H170V96H188" class="link" marker-end="url(#arw-h)" />
      </g>
      <g data-topics="feeding" class={'mini' + on('feeding')}><circle cx="120" cy="40" r="10" /><text x="120" y="43.5">1</text></g>
      <g data-topics="unloading" class={'ext' + on('unloading')}>
        <path d="M190 199H122" class="link" marker-end="url(#arw-h)" />
        <rect x="30" y="182" width="90" height="34" rx="4" class="box" /><text x="75" y="203" class="label">Tray unloader</text>
      </g>
      <g data-topics="unloading" class={'mini' + on('unloading')}><circle cx="120" cy="182" r="10" /><text x="120" y="185.5">6</text></g>
      <g data-topics="labeling" class={'ext' + on('labeling')}>
        <path d="M75 216V228" class="link" marker-end="url(#arw-h)" />
        <rect x="30" y="230" width="90" height="30" rx="4" class="box" /><text x="75" y="249" class="label">Labeling</text>
      </g>
      <g data-topics="labeling" class={'mini' + on('labeling')}><circle cx="120" cy="230" r="10" /><text x="120" y="233.5">7</text></g>
      <g data-topics="inspection qc" class={'ext' + on('inspection qc')}>
        <path d="M420 236V256" class="link" marker-end="url(#arw-h)" />
        <rect x="390" y="258" width="60" height="28" rx="4" class="box" /><text x="420" y="276" class="label">Reject</text>
      </g>
    </svg>

    <!-- Tall drawing (phones), oriented like the owner's sketch -->
    <svg class="layout layout-tall" viewBox="0 0 380 610" role="img" aria-label={label}>
      <defs><marker id="arw-v" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L8 4L0 8z" class="arrow-head" /></marker></defs>
      <rect x="100" y="104" width="200" height="456" data-topics="safety" class={'guard' + on('safety')} />
      <path d="M150 560v30a30 30 0 0 0 30-30M220 560v30a30 30 0 0 0 30-30" data-topics="safety" class={'door' + on('safety')} />
      <g data-topics="safety" class={'mini' + on('safety')}><circle cx="300" cy="560" r="10" /><text x="300" y="563.5">8</text></g>
      <rect x="172" y="122" width="54" height="420" rx="27" class="track" />
      <rect x="186" y="136" width="26" height="392" rx="13" class="track-inner" />
      {Array.from({ length: 9 }, (_, k) => <rect x="175" y={146 + k * 42} width="9" height="12" rx="2" class="pallet" />)}
      {Array.from({ length: 9 }, (_, k) => <rect x="214" y={146 + k * 42} width="9" height="12" rx="2" class="pallet" />)}
      <path d="M214 338l4.5 6 4.5-6M175 344l4.5-6 4.5 6" class="flow-arrow" />
      {tall.map(s => (
        <g data-topics={topicsOf(s.nums)} class={'st' + on(topicsOf(s.nums))}>
          <rect x={s.x} y={s.y} width={s.w} height={s.h} rx="4" class="box" />
          {minis(s, 10).map(m => <g data-topics={m.id} class={'mini' + on(m.id)}><circle cx={m.cx} cy={m.cy} r={m.r} /><text x={m.cx} y={m.cy + 3.5}>{m.n}</text></g>)}
        </g>
      ))}
      <g data-topics="feeding" class={'ext' + on('feeding')}>
        <rect x="306" y="30" width="70" height="30" rx="4" class="box" /><text x="341" y="49" class="label small">Tray loader</text>
        <path d="M341 60V150H296" class="link" marker-end="url(#arw-v)" />
        <circle cx="341" cy="196" r="14" class="box" /><path d="M333 196a8 8 0 0 1 16 0" class="thin" />
        <path d="M327 190H296" class="link" marker-end="url(#arw-v)" />
        <text x="341" y="226" class="label small">Bowl feeder</text>
      </g>
      <g data-topics="feeding" class={'mini' + on('feeding')}><circle cx="376" cy="30" r="10" /><text x="376" y="33.5">1</text></g>
      <g data-topics="unloading" class={'ext' + on('unloading')}>
        <path d="M106 150H92" class="link" marker-end="url(#arw-v)" />
        <rect x="6" y="126" width="84" height="40" rx="4" class="box" /><text x="48" y="150" class="label small">Tray unloader</text>
      </g>
      <g data-topics="unloading" class={'mini' + on('unloading')}><circle cx="90" cy="126" r="10" /><text x="90" y="129.5">6</text></g>
      <g data-topics="labeling" class={'ext' + on('labeling')}>
        <path d="M48 166V180" class="link" marker-end="url(#arw-v)" />
        <rect x="6" y="182" width="84" height="30" rx="4" class="box" /><text x="48" y="201" class="label small">Labeling</text>
      </g>
      <g data-topics="labeling" class={'mini' + on('labeling')}><circle cx="90" cy="182" r="10" /><text x="90" y="185.5">7</text></g>
      <g data-topics="inspection qc" class={'ext' + on('inspection qc')}>
        <path d="M106 378H82" class="link" marker-end="url(#arw-v)" />
        <rect x="20" y="364" width="60" height="28" rx="4" class="box" /><text x="50" y="382" class="label small">Reject</text>
      </g>
    </svg>
    <figcaption class="layout-caption">Schematic, not to scale. Not a specific machine.</figcaption>
  </figure>
  <div class="explorer-side">
    <ul class="spot-chips" aria-label="Topics of the machine">
      {machine.spots.map((spot, i) => (
        <li><button type="button" class:list={['spot-chip', { 'is-active': i === 0 }]} data-spot={spot.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span class="chip-num" aria-hidden="true">{i + 1}</span>{spot.title}
        </button></li>
      ))}
    </ul>
    <div class="spot-panels" aria-live="polite">
      {machine.spots.map((spot, i) => (
        <div class="spot-panel" data-spot-panel={spot.id} hidden={i !== 0}>
          <h3 class="spot-title">{spot.title}</h3>
          <p class="spot-text">{spot.function}</p>
          <p class="spot-label">My role</p>
          <p class="spot-text">{spot.role}</p>
          <p class="spot-label">Lifecycle steps</p>
          <ul class="spot-steps">
            {spot.phases.map(id => <li><a href={`#phase-${id}`}>{pad(index[id])} {phaseShort[id]}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</div>
<style>
  .explorer { margin-top: 28px; display: grid; gap: 24px; align-items: start; }
  .explorer-figure { margin: 0; padding: 16px; border: 1px solid #D5DCE3; border-radius: var(--radius-panel); background: var(--color-white); }
  .layout { display: block; width: 100%; height: auto; overflow: visible; }
  .layout-wide { display: none; }
  .layout-tall { max-width: 420px; margin-inline: auto; }
  .layout-caption { margin-top: 8px; font-size: .8125rem; color: var(--color-steel); }
  .track { fill: var(--color-mist); stroke: var(--color-ink); stroke-width: 1.2; }
  .track-inner { fill: var(--color-white); stroke: #9AA5B1; stroke-width: 1; }
  .pallet { fill: var(--color-white); stroke: var(--color-ink); stroke-width: 1; }
  .flow-arrow { fill: none; stroke: var(--color-cobalt); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .box { fill: var(--color-white); stroke: var(--color-ink); stroke-width: 1.2; transition: fill .2s, stroke .2s; }
  .thin { fill: none; stroke: #9AA5B1; stroke-width: 1; }
  .link { fill: none; stroke: var(--color-steel); stroke-width: 1.3; transition: stroke .2s; }
  .arrow-head { fill: var(--color-steel); }
  .guard { fill: none; stroke: var(--color-ink); stroke-width: 2.4; transition: stroke .2s; }
  .door { fill: none; stroke: var(--color-steel); stroke-width: 1; stroke-dasharray: 3 2; transition: stroke .2s; }
  .label { font-size: 10.5px; fill: var(--color-ink); text-anchor: middle; }
  .label.small { font-size: 9.5px; }
  .mini circle { fill: var(--color-white); stroke: var(--color-cobalt); stroke-width: 1.3; transition: fill .2s; }
  .mini text { font-size: 10px; font-weight: 600; fill: var(--color-cobalt); text-anchor: middle; transition: fill .2s; }
  .mini.is-active circle { fill: var(--color-cobalt); }
  .mini.is-active text { fill: var(--color-white); }
  .st.is-active .box, .ext.is-active .box { fill: var(--color-cobalt-tint); stroke: var(--color-cobalt); stroke-width: 2; }
  .ext.is-active .link { stroke: var(--color-cobalt); }
  .guard.is-active { stroke: var(--color-cobalt); }
  .door.is-active { stroke: var(--color-cobalt); stroke-width: 1.4; }
  .spot-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .spot-chip { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px 0 8px; border-radius: 999px; border: 1px solid #D5DCE3; background: var(--color-white); color: var(--color-ink); font: inherit; font-size: .9375rem; cursor: pointer; transition: background-color .2s, border-color .2s; }
  .chip-num { width: 24px; height: 24px; border-radius: 999px; display: grid; place-items: center; border: 1.4px solid var(--color-cobalt); color: var(--color-cobalt); font-size: .75rem; font-weight: 600; }
  .spot-chip:hover { border-color: var(--color-cobalt); }
  .spot-chip.is-active { background: var(--color-cobalt-tint); border-color: var(--color-cobalt); color: var(--color-cobalt-deep); }
  .spot-chip.is-active .chip-num { background: var(--color-cobalt); color: var(--color-white); }
  .spot-panels { margin-top: 16px; padding: 20px; border-radius: var(--radius-inner); background: var(--color-cobalt-tint); min-height: 14rem; }
  .spot-title { font-size: 1.1875rem; }
  .spot-text { margin-top: 6px; color: var(--color-ink); }
  .spot-label { margin-top: 14px; font-size: .875rem; font-weight: 600; color: var(--color-cobalt); }
  .spot-steps { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .spot-steps a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border-radius: 999px; background: var(--color-white); color: var(--color-ink); text-decoration: none; font-size: .9375rem; font-weight: 500; }
  .spot-steps a:hover { color: var(--color-cobalt); }
  @media (min-width: 768px) {
    .layout-wide { display: block; }
    .layout-tall { display: none; }
  }
  @media (min-width: 1024px) {
    .explorer-figure { padding: 24px; }
    .explorer-side { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 24px; align-items: start; }
    .spot-panels { margin-top: 0; }
  }
</style>
