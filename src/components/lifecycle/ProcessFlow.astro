---
/**
 * Process flow: the eight phases as a left-to-right flow diagram, 01 to 08. Each box links to its
 * detailed phase below (opened by the page script; a plain anchor without it).
 */
import PhaseIcon from './PhaseIcon.astro';
import { phases } from '../../lib/portfolio';
const pad = (n: number) => String(n + 1).padStart(2, '0');
---
<nav class="flow" aria-label="Process flow">
  <ol class="flow-list">
    {phases.map((p, i) => (
      <li class="flow-item">
        <a class="flow-box" href={`#phase-${p.id}`} data-flow={p.id}>
          <span class="flow-head">
            <span class="flow-icon"><PhaseIcon id={p.id} /></span>
            <span class="flow-num">{pad(i)}</span>
          </span>
          <span class="flow-title">{p.title}</span>
        </a>
      </li>
    ))}
  </ol>
  <p class="flow-caption">Select a phase for its technical responsibilities and deliverables.</p>
</nav>
<style>
  .flow { margin-top: 32px; }
  @media (min-width: 1024px) { .flow .flow-list { max-width: none; } }
  .flow-list { --cols: 2; --gap: 30px; max-width: 880px; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 14px var(--gap); counter-reset: none; }
  .flow-item { position: relative; display: flex; }
  /* Arrow to the next box in the same row. */
  .flow-item::after {
    content: ''; position: absolute; top: 50%; right: calc(var(--gap) * -1 + 6px); width: 8px; height: 8px;
    border-top: 1.6px solid var(--color-steel); border-right: 1.6px solid var(--color-steel);
    transform: translateY(-50%) rotate(45deg);
  }
  .flow-item::before {
    content: ''; position: absolute; top: 50%; right: calc(var(--gap) * -1 + 6px); width: calc(var(--gap) - 10px); height: 1.6px; background: var(--color-steel);
  }
  .flow-item:nth-child(2n)::after, .flow-item:nth-child(2n)::before { display: none; }
  .flow-box {
    flex: 1; display: flex; flex-direction: column; gap: 10px; min-height: 44px; padding: 14px; border-radius: var(--radius-inner);
    border: 1px solid #D5DCE3; background: var(--color-white); color: var(--color-ink); text-decoration: none;
    transition: border-color .2s, background-color .2s, transform .18s ease;
  }
  .flow-box:hover { border-color: var(--color-cobalt); background: var(--color-cobalt-tint); }
  .flow-box:active { transform: scale(.98); }
  .flow-head { display: flex; align-items: center; justify-content: space-between; }
  .flow-icon { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; background: var(--color-cobalt-tint); color: var(--color-cobalt); }
  .flow-icon :global(svg) { width: 22px; height: 22px; }
  .flow-num { font-size: .8125rem; font-weight: 600; color: var(--color-steel); font-variant-numeric: tabular-nums; }
  .flow-title { font-size: .9375rem; line-height: 1.3; font-weight: 600; overflow-wrap: normal; }
  .flow-caption { margin-top: 12px; font-size: .875rem; color: var(--color-steel); }
  @media (min-width: 768px) {
    .flow-list { --cols: 4; --gap: 34px; }
    .flow-item:nth-child(2n)::after, .flow-item:nth-child(2n)::before { display: block; }
    .flow-item:nth-child(4n)::after, .flow-item:nth-child(4n)::before { display: none; }
  }
</style>
