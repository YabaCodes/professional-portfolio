---
interface Props { compact?:boolean }
const {compact=false}=Astro.props;
---
<figure class="faucet-concept">
 <svg viewBox="0 0 340 190" role="img" aria-label="Independent simplified illustration of a sensor-controlled faucet, with sensing, dispensing and control functions" focusable="false">
  <g stroke="currentColor" stroke-width=".6" opacity=".15">
   {Array.from({length:17},(_,i)=><path d={`M${10+i*20} 8V182`}/>)}
   {Array.from({length:9},(_,i)=><path d={`M10 ${10+i*20}H330`}/>)}
  </g>
  <g stroke="currentColor" fill="none" stroke-width="1.4" stroke-linejoin="round">
   <path d="M95 103V42Q95 12 131 12Q167 12 167 42V59H153V42Q153 26 131 26Q109 26 109 42V103Z"/>
   <ellipse cx="102" cy="105" rx="25" ry="8"/>
   <path d="M38 112H218L254 90H216M38 112V126H218L254 104V90M218 112V126"/>
   <path d="M102 128V161H180"/>
   <rect x="180" y="146" width="64" height="30" rx="3"/>
   <path d="M160 67V80M155 84V97M165 84V97" stroke-dasharray="3 3"/>
   <path d="M176 67L185 80M181 61L193 68M180 51L194 51" opacity=".75"/>
   <path d="M167 44L233 44H310M170 77H260V65H310M244 161H310"/>
  </g>
  <g fill="currentColor" font-size="8" font-family="monospace" text-anchor="end">
   <text x="310" y="39">SENSING</text>
   <text x="310" y="60">DISPENSING</text>
   <text x="310" y="156">CONTROL</text>
  </g>
 </svg>
 {!compact&&<figcaption class="technical-caption mt-3">Independent conceptual illustration; not an official patent drawing or a validated product design.</figcaption>}
</figure>
<style>
 .faucet-concept{min-width:0;color:var(--color-deep-teal)}
 :global(.technical-surface) .faucet-concept{color:var(--color-jade)}
 svg{display:block;width:100%;height:auto}
</style>
