---
interface Props { class?: string; }
const { class: className } = Astro.props;
---
<figure class={className}>
  <svg viewBox="0 0 340 230" width="340" height="230" class="mx-auto w-full max-w-md text-teal" role="img" aria-label="Independent conceptual illustration of two stacked geometric assembly volumes with reference axes" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width=".6" opacity=".22">
      {Array.from({length: 11}, (_, i) => <path d={`M${20 + i * 30} 10V210 M20 ${10 + i * 20}H320`} />)}
    </g>
    <g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.4">
      <path d="M45 114 170 42 295 114 170 186Z M45 114V138L170 210 295 138V114 M170 186V210"/>
      <path d="M103 70 170 32 237 70 170 109Z M103 70V104L170 143 237 104V70 M170 109V143"/>
      <ellipse cx="170" cy="70" rx="30" ry="16"/>
      <ellipse cx="170" cy="70" rx="15" ry="8"/>
      <path d="M170 10V220 M30 114H310 M103 104V140 M237 104V140" stroke-dasharray="4 5" stroke-width=".8"/>
      <circle cx="170" cy="70" r="5"/>
    </g>
  </svg>
  <figcaption class="technical-caption mt-2">FIG. 01 — Original conceptual geometry; not an actual manufacturing system.</figcaption>
</figure>
<style>
  :global(.technical-surface) svg { color: var(--color-jade); }
</style>
