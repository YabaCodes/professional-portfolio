---
interface Props { compact?:boolean; }
const {compact=false}=Astro.props;
---
<figure class:list={['lattice-figure',{'compact':compact}]}>
 <svg viewBox="0 0 420 220" role="img" aria-label="Original schematic of a cylindrical lattice with torsion arrows and longitudinal axis">
  <g stroke="currentColor" fill="none" opacity=".22" stroke-width=".6">
   {Array.from({length:17},(_,i)=><path d={`M${10+i*25} 10V210`}/>)}
   {Array.from({length:9},(_,i)=><path d={`M10 ${10+i*25}H410`}/>)}
  </g>
  <g stroke="currentColor" fill="none" stroke-width="1.2">
   <path d="M100 61H320M100 159H320"/>
   <ellipse cx="100" cy="110" rx="27" ry="49"/>
   <ellipse cx="320" cy="110" rx="27" ry="49"/>
   {Array.from({length:11},(_,i)=><path opacity=".75" d={`M${100+i*20} 61 Q${110+i*20} 110 ${100+i*20} 159 M${100+i*20} 61 L${Math.min(320,120+i*20)} 110 L${100+i*20} 159`}/>)}
   <path stroke-dasharray="5 5" d="M42 110H378"/>
   <path stroke-width="2" d="M67 48C33 69 28 132 67 170l-13 -1 6 -12M353 172C389 150 392 88 353 50l13 1 -6 12"/>
  </g>
 </svg>
 {!compact&&<figcaption class="technical-caption">Conceptual torsional loading — original illustrative geometry, not an experimentally validated simulation or an original research specimen.</figcaption>}
</figure>
<style>
 .lattice-figure{color:var(--color-deep-teal);min-width:0;}
 :global(.technical-surface) .lattice-figure{color:var(--color-jade);}
 .lattice-figure svg{display:block;width:100%;height:auto;}
</style>
