---
import Wordmark from '../brand/Wordmark.astro';
import { routeHref, sectionHref, sections } from '../../lib/site';
---
<header class="technical-surface site-header">
  <div class="page-container header-row">
    <a href={routeHref('')} class="brand-link" aria-label="Yeabsra Mekdim — home"><Wordmark /></a>
    <nav aria-label="Primary navigation" class="desktop-nav">
      {sections.map(s => <a href={sectionHref(s.id)} class="nav-link">{s.label}</a>)}
    </nav>
    <details class="mobile-nav">
      <summary class="menu-toggle">Menu <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor"><path d="M3 5h14M3 10h14M3 15h14" stroke-width="1.5"/></svg></summary>
      <nav aria-label="Mobile primary navigation" class="mobile-links">
        {sections.map(s => <a href={sectionHref(s.id)} class="nav-link">{s.label}</a>)}
      </nav>
    </details>
  </div>
</header>
<script>
  // Close the mobile menu once a section is chosen, so it never covers the content.
  for (const link of document.querySelectorAll('.mobile-links a')) {
    link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
  }
</script>
<style>
  .site-header { border-bottom: 1px solid var(--color-slate); }
  .header-row { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:72px; padding-block:10px; }
  .brand-link { display:inline-flex; align-items:center; min-height:44px; min-width:44px; color:var(--color-ivory); text-decoration:none; font-size:clamp(.94rem,2.1vw,1.1rem); }
  .desktop-nav { display:none; align-items:center; gap:clamp(6px,1.5vw,22px); }
  .nav-link { display:flex; align-items:center; min-height:44px; min-width:44px; padding:6px 4px; color:var(--color-structural); text-decoration:none; font-size:.9rem; }
  .nav-link:hover { color:var(--color-jade); text-decoration:underline; text-underline-offset:6px; }
  .mobile-nav { position:relative; flex-shrink:0; }
  .menu-toggle { cursor:pointer; display:flex; align-items:center; gap:8px; min-height:44px; min-width:44px; padding-inline:8px; color:var(--color-ivory); list-style:none; font-size:.9rem; }
  .menu-toggle::-webkit-details-marker { display:none; }
  .mobile-links { position:absolute; inset-inline-end:0; top:calc(100% + 8px); width:min(240px,calc(100vw - 40px)); background:var(--color-navy); border:1px solid var(--color-slate); padding:8px 16px; z-index:5; }
  @media(min-width:900px) { .desktop-nav {display:flex;} .mobile-nav {display:none;} }
</style>
