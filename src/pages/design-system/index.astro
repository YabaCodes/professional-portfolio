---
import '@fontsource-variable/instrument-sans/wdth.css';
import '../../styles/global.css';
import Wordmark from '../../components/brand/Wordmark.astro';
import Monogram from '../../components/brand/Monogram.astro';
const tokens = [
  { name: 'White', color: '#FFFFFF', use: 'Page ground' },
  { name: 'Mist', color: '#EEF2F5', use: 'Panels and chips' },
  { name: 'Ink', color: '#15191E', use: 'Headings and text' },
  { name: 'Body', color: '#2B323A', use: 'Long text' },
  { name: 'Steel', color: '#55606B', use: 'Secondary text' },
  { name: 'Outline', color: '#7D8995', use: 'Button and menu borders' },
  { name: 'Line', color: '#E3E8EC', use: 'Dividers' },
  { name: 'Cobalt', color: '#2342B0', use: 'Primary action, active phase' },
  { name: 'Cobalt deep', color: '#16297A', use: 'Hover' },
  { name: 'Cobalt tint', color: '#E8ECFB', use: 'Open phase panel' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Cleanroom — development specimen</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  </head>
  <body>
    <a class="skip-link action-link" href="#main-content">Skip to content</a>
    <header class="specimen-header">
      <div class="page-container specimen-row">
        <Wordmark />
        <p class="secondary-text">Cleanroom design specimen, PP-009</p>
      </div>
    </header>
    <main id="main-content" class="page-container specimen-main">
      <section aria-labelledby="palette-heading">
        <h1 id="palette-heading">Cleanroom</h1>
        <p class="secondary-text reading-width mt-3">Development specimen only. White ground, mist panels, ink text and one cobalt accent. Instrument Sans for everything.</p>
        <ul class="swatches">
          {tokens.map(t => <li class="swatch">
            <span class="swatch-color" style={`background-color: ${t.color}`} aria-hidden="true"></span>
            <span><strong>{t.name}</strong><br /><span class="secondary-text">{t.color} · {t.use}</span></span>
          </li>)}
        </ul>
      </section>
      <section aria-labelledby="type-heading" class="specimen-block">
        <h2 id="type-heading">Type and components</h2>
        <p class="reading-width mt-3">Body text at 16–17 px with 1.6 line height. Headings at weight 600, slightly narrowed, with tight tracking.</p>
        <div class="button-row mt-6">
          <a class="action-link" href="#type-heading">Primary action</a>
          <a class="ghost-link" href="#type-heading">Secondary action</a>
        </div>
        <ul class="chip-row mt-6" aria-label="Chip sample"><li class="chip">Chip</li><li class="chip">Good documentation practice</li></ul>
        <div class="panel specimen-panel mt-6">
          <Monogram class="specimen-mark" />
          <div><Wordmark /><p class="secondary-text mt-1">Secondary brand mark</p></div>
        </div>
      </section>
    </main>
    <footer class="specimen-footer">
      <div class="page-container"><p class="secondary-text">Development only / Not authorized for production deployment.</p></div>
    </footer>
    <style>
      .specimen-header { border-bottom: 1px solid var(--color-line); }
      .specimen-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; min-height: 68px; }
      .specimen-main { padding-block: 48px; }
      .specimen-block { margin-top: 56px; }
      .swatches { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
      .swatch { display: flex; align-items: center; gap: 14px; padding: 12px; border: 1px solid var(--color-line); border-radius: 14px; }
      .swatch-color { width: 48px; height: 48px; flex-shrink: 0; border-radius: 10px; border: 1px solid var(--color-line); }
      .specimen-panel { display: flex; align-items: center; gap: 16px; padding: 24px; max-width: 420px; }
      .specimen-mark { width: 56px; color: var(--color-cobalt); flex-shrink: 0; }
      .specimen-footer { border-top: 1px solid var(--color-line); padding-block: 24px; font-size: .875rem; }
    </style>
  </body>
</html>
