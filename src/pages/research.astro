---
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchPublicationCard from '../components/content/ResearchPublicationCard.astro';
import ResearchPatentCard from '../components/content/ResearchPatentCard.astro';
import {loadCatalog} from '../lib/content/catalog';
import {routeHref} from '../lib/site';
const catalog=await loadCatalog();
const publications=(await getCollection('publications')).sort((a,b)=>a.data.id.localeCompare(b.data.id));
const patents=(await getCollection('patents')).sort((a,b)=>a.data.id.localeCompare(b.data.id));
const firstAuthor=publications.filter(p=>p.data.authorship==='first-author').length;
const title='Engineering through investigation and invention.';
const description='Exploring the relationship between engineering design, scientific evidence and technological innovation.';
---
<BaseLayout title="Research & Innovation" description={description} route="research">
 <section class="technical-surface section-space" aria-labelledby="research-page-title">
  <div class="page-container">
   <p class="technical-label mb-4">Research & Innovation / Public evidence</p>
   <h1 id="research-page-title">{title}</h1>
   <p class="secondary-text reading-width mt-5">{description}</p>
   <dl class="research-stats mt-8">
    {[
     {label:'Peer-reviewed publications',value:publications.length},
     {label:'First-author papers',value:firstAuthor},
     {label:'Granted US patent',value:patents.length}
    ].map(item=><div class="border border-slate p-4"><dd class="font-display font-bold text-3xl text-jade">{String(item.value).padStart(2,'0')}</dd><dt class="text-sm mt-2">{item.label}</dt></div>)}
   </dl>
  </div>
 </section>
 <section class="page-container section-space" aria-labelledby="research-focus">
  <p class="technical-label mb-3">01 / Research focus</p>
  <h2 id="research-focus">Mechanical engineering & advanced manufacturing</h2>
  <ul class="editorial-grid mt-6">
   {['Advanced lattice structures','Structural mechanics','Additive manufacturing','Experimental characterization'].map(topic=><li class="span-half border-t border-structural pt-3 font-medium">{topic}</li>)}
  </ul>
 </section>
 <section class="page-container pb-16" aria-labelledby="research-publications">
  <hr class="rule mb-10"/>
  <p class="technical-label mb-3">02 / Selected publications</p>
  <h2 id="research-publications">Peer-reviewed research.</h2>
  <div class="grid gap-5 mt-7" data-publication-catalog>
   {publications.map(pub=><ResearchPublicationCard entry={pub} catalog={catalog}/>)}
  </div>
 </section>
 <section class="page-container pb-16" aria-labelledby="research-patent">
  <hr class="rule mb-10"/>
  <p class="technical-label mb-3">03 / Intellectual property</p>
  <h2 id="research-patent">Granted invention.</h2>
  <div class="grid gap-5 mt-7" data-patent-catalog>
   {patents.map(patent=><ResearchPatentCard entry={patent} catalog={catalog}/>)}
  </div>
 </section>
 <section class="page-container pb-16" aria-labelledby="research-practice">
  <hr class="rule mb-10"/>
  <p class="technical-label mb-3">04 / Research in practice</p>
  <h2 id="research-practice">From experiments to engineering insight.</h2>
  <p class="reading-width mt-4">The publicly documented lattice research provides supporting evidence for the related engineering case study.</p>
  <a class="inline-flex min-h-11 items-center mt-5 font-semibold" data-related-research-case href={routeHref('work/advanced-lattice-structures')}>Engineering the Mechanics of Advanced Lattice Structures <span aria-hidden="true" class="ml-2">→</span></a>
  <div class="border-t border-structural mt-8 pt-5">
   <p class="technical-label">Researcher identity</p>
   <p class="mt-2">ORCID — 0000-0003-1044-453X</p>
   <a href="https://orcid.org/0000-0003-1044-453X" class="inline-flex min-h-11 items-center font-semibold" data-orcid-link>View ORCID profile <span aria-hidden="true" class="ml-2">↗</span></a>
   <p class="technical-caption mt-2">Researcher identifier associated with a published co-author record.</p>
  </div>
 </section>
</BaseLayout>
<style>
 .research-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
 @media(max-width:480px){.research-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.research-stats>div:last-child{grid-column:1/-1}}
</style>
