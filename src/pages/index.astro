---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptualSystem from '../components/illustrations/ConceptualSystem.astro';
import CredibilityStrip from '../components/content/CredibilityStrip.astro';
import { identity,pillars,routeHref } from '../lib/site';
import {pillarIds} from '../lib/content/expertise';
import {getCollection} from 'astro:content';
import {loadCatalog} from '../lib/content/catalog';
import CaseStudyCards from '../components/content/CaseStudyCards.astro';
await loadCatalog();
const work=(await getCollection('case-studies')).sort((a,b)=>a.data.id.localeCompare(b.data.id));
---
<BaseLayout title={identity.name} description={identity.introduction} home>
 <section class="technical-surface section-space" aria-labelledby="hero-heading">
  <div class="page-container editorial-grid items-center" data-grid="responsive">
   <div class="span-two-thirds">
    <p class="technical-label mb-6">{identity.positioning}</p>
    <h1 id="hero-heading" class="hero-title max-w-[16ch]">{identity.headline[0]}<span class="mt-4 block text-jade">{identity.headline[1]}</span></h1>
    <p class="secondary-text reading-width mt-6">{identity.introduction}</p>
    <div class="flex flex-wrap gap-4 mt-8">
     <a href={routeHref('work')} class="action-link">Explore selected work <span aria-hidden="true">→</span></a>
     <a href={routeHref('about')} class="inline-flex min-h-11 items-center">Professional profile</a>
    </div>
   </div>
   <ConceptualSystem class="span-one-third"/>
  </div>
 </section>
 <section class="page-container section-space" aria-labelledby="profile">
  <div class="editorial-grid items-center">
   <div class="span-one-third"><p class="technical-label mb-3">01 / Profile</p><h2 id="profile">Yeabsra Mekdim</h2></div>
   <div class="span-two-thirds"><p class="reading-width">{identity.introduction}</p><a class="inline-flex min-h-11 items-center mt-3" href={routeHref('about')}>About me <span aria-hidden="true">→</span></a></div>
  </div>
  <CredibilityStrip/>
 </section>
 <section class="page-container pb-16" aria-labelledby="selected-work">
  <hr class="rule mb-10"/>
  <p class="technical-label mb-3">02 / Selected work</p><h2 id="selected-work">Engineering in practice.</h2>
  <p class="secondary-text mt-4 reading-width">Selected work, engineering methodology and authorized professional evidence.</p>
  <CaseStudyCards entries={work.slice(0,4)}/>
  {work.length===0&&<p class="technical-caption mt-5">Case study content is under development and separate review.</p>}
  <a class="inline-flex min-h-11 items-center mt-5" href={routeHref('work')}>Selected work <span aria-hidden="true">→</span></a>
 </section>
 <section class="page-container pb-16" aria-labelledby="pillars-title">
  <hr class="rule mb-10"/>
  <p class="technical-label mb-3">03 / Professional expertise</p><h2 id="pillars-title">Four professional pillars.</h2>
  <div class="editorial-grid mt-8">{pillars.map((pillar,i)=><div class="span-half border-t border-structural pt-5 pb-4"><p class="technical-label mb-3">{String(i+1).padStart(2,'0')}</p><h3><a href={routeHref('expertise')+'#pillar-'+pillarIds[i]} class="inline-flex min-h-11 min-w-11 items-center">{pillar}</a></h3></div>)}</div>
  <a class="inline-flex min-h-11 items-center mt-4" href={routeHref('expertise')}>Explore expertise <span aria-hidden="true">→</span></a>
 </section>
 <section class="technical-surface section-space" aria-labelledby="lab">
  <div class="page-container editorial-grid items-center">
   <div class="span-two-thirds"><p class="technical-label mb-3">04 / Engineering Lab</p><h2 id="lab">Independent engineering demonstrations.</h2><p class="secondary-text reading-width mt-5">Original engineering tools, transparent assumptions and independently developed demonstrations.</p><a class="action-link mt-6" href={routeHref('insights/lab')}>Explore Engineering Lab <span aria-hidden="true">→</span></a></div>
   <div class="span-one-third border border-slate p-5"><p class="technical-label">EL-001 / Development</p><h3 class="mt-3">Overall Equipment Effectiveness</h3><p class="secondary-text mt-3 text-sm">Interactive demonstration not yet available.</p></div>
  </div>
 </section>
 <section class="page-container section-space" aria-labelledby="research">
  <p class="technical-label mb-3">05 / Research & innovation</p><h2 id="research">Research and intellectual property.</h2>
  <p class="reading-width mt-5">I have contributed to three academic publications and am a co-inventor of a granted United States patent.</p>
  <a class="inline-flex min-h-11 items-center mt-5" href={routeHref('research')}>Explore research & innovation <span aria-hidden="true">→</span></a>
 </section>
 <section class="page-container pb-16" aria-labelledby="contact">
  <hr class="rule mb-10"/><p class="technical-label mb-3">06 / Résumé & contact</p><h2 id="contact">Professional opportunities.</h2>
  <p class="reading-width secondary-text mt-4">Explore ways to connect around engineering leadership, manufacturing technology and complex technical programs.</p>
  <a class="action-link mt-6" href={routeHref('contact')}>Résumé & contact <span aria-hidden="true">→</span></a>
 </section>
</BaseLayout>
