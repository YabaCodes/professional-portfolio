---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { loadCatalog } from '../lib/content/catalog';
import { identity } from '../lib/site';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import { yearsSince } from '../lib/portfolio';
import { hero, atAGlance, process, phases, trackRecord, practice, experienceHeading, experienceSubheading, skills, contact, machine, displayDate } from '../lib/portfolio';
import ProcessFlow from '../components/lifecycle/ProcessFlow.astro';
import MachineExplorer from '../components/lifecycle/MachineExplorer.astro';
import SectionBar from '../components/shell/SectionBar.astro';
import { approvedContact, approvedEmail, approvedResume } from '../lib/publication';
await loadCatalog();
const career = (await getCollection('career')).map(e => e.data).sort((a, b) => b.start.localeCompare(a.start));
const credentials = (await getCollection('credentials')).map(e => e.data)
  .sort((a, b) => (a.category === b.category ? b.issued.localeCompare(a.issued) : a.category === 'education' ? -1 : 1));
const publications = (await getCollection('publications')).map(e => e.data).sort((a, b) => a.year - b.year || a.id.localeCompare(b.id));
const patents = (await getCollection('patents')).map(e => e.data);

---
<BaseLayout title={identity.name} description={identity.introduction} home>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-grid-bg drawing-grid" aria-hidden="true"></div>
    <div class="page-container hero-grid">
      <div class="hero-copy">
        <div class="hero-id">
          <Image src={portrait} alt={`Portrait of ${hero.name}`} class="hero-portrait" widths={[96, 192, 288, 384]} sizes="(min-width: 1024px) 184px, (min-width: 768px) 132px, 88px" loading="eager" fetchpriority="high" />
          <div class="hero-id-text">
            <p class="hero-name">{hero.name}</p>
            <p class="hero-kicker">{(() => { const [role, ...rest] = hero.titleLine.split(' · '); return <><span class="kicker-role">{role}</span><span class="kicker-sep"> · </span><span>{rest.join(' · ')}</span></>; })()}</p>
          </div>
        </div>
        <h1 id="hero-heading" class="hero-title">{hero.headline}</h1>
        <p class="hero-intro">{hero.introduction}</p>
      </div>
      <div class="panel glance" role="group" aria-label="At a glance">
        <dl class="glance-machines">
          <div class="glance-item glance-wide glance-years">
            <dt>{atAGlance.experience.label}</dt>
            <dd class="glance-value" data-glance-years>{yearsSince(atAGlance.experience.since)}+ years</dd>
          </div>
          {atAGlance.machines.map(item => (
            <div class="glance-item">
              <dt>{item.label}</dt>
              <dd class="glance-value glance-value-big">{item.value}</dd>
              <dd class="glance-detail">{item.detail}</dd>
            </div>
          ))}
          <div class="glance-item glance-wide glance-scale">
            <dt>{atAGlance.scale.label}</dt>
            <dd class="glance-value">{atAGlance.scale.value}</dd>
          </div>
        </dl>
        <dl class="glance-facts">
          {atAGlance.facts.map(item => (
            <div class:list={['glance-item', { 'glance-wide': item.wide }]}>
              <dt>{item.label}</dt>
              <dd class="glance-value">{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <SectionBar />

  <section id="process" class="section-block section-ruled" aria-labelledby="process-heading" data-reveal>
    <div class="page-container">
      <h2 id="process-heading">{process.heading}</h2>
      <div class="reading-width section-intro intro-cols">
        {process.introduction.map(text => <p class="secondary-text">{text}</p>)}
      </div>
      <ProcessFlow />
      <ol class="steps" aria-label="Manufacturing equipment development phases">
        {phases.map((p, i) => (
          <li class="step" id={`phase-${p.id}`} data-phase={p.id}>
            <details class="phase" name="phase" open={i === 0}>
              <summary class="phase-summary">
                <span class="step-dot" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="phase-text">
                  <span class="phase-title">{p.title}</span>
                  <span class="phase-line">{p.tags.map((tag, j) => <>{j > 0 && <span class="tag-sep" aria-hidden="true"> · </span>}<span class="tag">{tag}</span></>)}</span>
                </span>
                <span class="phase-icon" aria-hidden="true"></span>
              </summary>
              <div class="phase-body">
                <p class="phase-lead">{p.lead}</p>
                <div>
                  <p class="body-label">Technical Responsibilities</p>
                  <ul class="duty-list">{p.responsibilities.map(item => <li>{item}</li>)}</ul>
                </div>
                <div>
                  <p class="body-label">Key Deliverables</p>
                  <p>{p.deliverables}</p>
                </div>
              </div>
            </details>
          </li>
        ))}
      </ol>

      <div class="track" data-track-record>
        <h3 id="track-heading" class="track-heading">{trackRecord.heading}</h3>
        <p class="track-intro">{trackRecord.introduction}</p>
        <div class="track-cols">
          <div>
            <h4 class="track-label">Completed</h4>
            <ul class="track-list">
              {trackRecord.completed.map(t => <li><span class="track-count">{t.count}</span><span>{t.item}</span></li>)}
            </ul>
          </div>
          <div>
            <h4 class="track-label">Ongoing</h4>
            <ul class="track-list">
              {trackRecord.inProgress.map(t => <li><span class="track-count">{t.count}</span><span>{t.item}</span></li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="machine" class="section-block section-ruled section-sheet drawing-grid" aria-labelledby="machine-heading" data-reveal>
    <div class="page-container">
      <h2 id="machine-heading">{machine.heading}</h2>
      <p class="secondary-text reading-width section-intro">{machine.introduction}</p>
      <MachineExplorer />
    </div>
  </section>

  <section class="page-container practice-wrap" aria-labelledby="practice-heading" data-reveal>
    <div class="panel practice">
      <h2 id="practice-heading" class="practice-heading">{practice.label}</h2>
      <p class="practice-text">{practice.statement}</p>
      <p class="practice-text">{practice.international}</p>
    </div>
  </section>

  <section id="experience" class="section-block section-ruled" aria-labelledby="experience-heading" data-reveal>
    <div class="page-container">
      <h2 id="experience-heading">{experienceHeading}</h2>
      <p class="secondary-text section-intro">{experienceSubheading}</p>
      <ol class="role-list">
        {career.map(role => (
          <li class="role" data-record-id={role.id}>
            <p class="role-dates">{displayDate(role.start)} – {role.end ? displayDate(role.end) : 'now'}</p>
            <div>
              <h3>{role.role}</h3>
              <p class="role-summary">{role.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="skills" class="section-block section-ruled" aria-labelledby="skills-heading" data-reveal>
    <div class="page-container">
      <h2 id="skills-heading">{skills.heading}</h2>
      <div class="skill-groups">
        {skills.groups.map(group => (
          <div class="skill-group" data-skill-group={group.group}>
            <div>
              <h3>{group.group}</h3>
            </div>
            <ul class="chip-row" aria-label={group.group}>
              {group.items.map(item => <li class="chip">{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="publications" class="section-block section-ruled" aria-labelledby="publications-heading" data-reveal>
    <div class="page-container credentials-grid">
      <div>
        <h2 id="education-heading">Education and Certifications</h2>
        <ul class="record-list" aria-labelledby="education-heading">
          {credentials.map(c => (
            <li data-credential-id={c.id}>
              <p class="record-title">{c.title}</p>
              <p class="record-meta">{c.issuer} · {c.issued}</p>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 id="publications-heading">Publications and Patent</h2>
        <ol class="record-list">
          {publications.map(p => (
            <li data-publication-id={p.id}>
              <a class="record-title record-link" href={'https://doi.org/' + p.doi}>{p.title}</a>
              <p class="record-meta">{p.venue} · {p.year}{p.authorship === 'first-author' ? ' · first author' : ''}</p>
            </li>
          ))}
          {patents.map(p => (
            <li data-patent-id={p.id}>
              <a class="record-title record-link" href={'https://patents.google.com/patent/' + p.patentNumber}>{p.title}</a>
              <p class="record-meta">{p.patentNumber.replace(/^US(\d+)B(\d)$/, 'US $1 B$2')} · granted patent · co-inventor</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section id="contact" class="page-container contact-wrap" aria-labelledby="contact-heading">
    <div class="panel contact drawing-grid">
      <div class="reading-width">
        <h2 id="contact-heading">{contact.heading}</h2>
        <p class="contact-intro">{contact.introduction}</p>
      </div>
      <div class="button-row">
        {approvedContact && <a class="action-link" href={approvedContact.href} data-approved-contact-link>{approvedContact.label}</a>}
        {approvedEmail && <a class="action-link" href={approvedEmail.href} data-approved-email-link>{approvedEmail.label}</a>}
        {approvedResume && <a class="ghost-link" href={approvedResume.assetPath} download data-approved-resume-link>{approvedResume.label}</a>}
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  import '../scripts/interactions.ts';
</script>

<style>
  /* Hero */
  .hero { position: relative; isolation: isolate; padding-block: clamp(40px, 7vw, 88px) clamp(40px, 6vw, 72px); }
  /* Grid strongest at the top right, fading out before it reaches the text. */
  .hero-grid-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; --grid-minor: rgb(35 66 176 / .06); --grid-major: rgb(35 66 176 / .11);
    -webkit-mask-image: radial-gradient(120% 100% at 100% 0%, #000 20%, transparent 72%);
    mask-image: radial-gradient(120% 100% at 100% 0%, #000 20%, transparent 72%); }
  .hero-grid { display: grid; gap: 36px; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .hero-id { display: flex; align-items: center; gap: 16px; }
  .hero-portrait { flex: none; width: 88px; height: 88px; object-fit: cover; border-radius: var(--radius-inner); border: 1px solid #D5DCE3; background: var(--color-mist); }
  .hero-id-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .hero-name { color: var(--color-ink); font-size: 1.125rem; font-weight: 600; line-height: 1.3; }
  .hero-kicker { color: var(--color-steel); font-size: .9375rem; line-height: 1.5; }
  @media (min-width: 768px) {
    .hero-id { gap: 22px; }
    .hero-portrait { width: 132px; height: 132px; }
    .hero-name { font-size: 1.25rem; }
  }
  .hero-title { max-width: 15ch; }
  .hero-intro { color: var(--color-body); font-size: clamp(1.0625rem, 1rem + .3vw, 1.25rem); max-width: 56ch; }
  .hero-copy .button-row { margin-top: 8px; }
  .glance { padding: 24px; display: flex; flex-direction: column; gap: 20px; background: var(--color-white); border: 1px solid #D5DCE3; box-shadow: 0 1px 0 rgb(21 25 30 / .03); }
  .glance dl { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 18px; }
  .glance-facts { padding-top: 20px; border-top: 1px solid #D5DCE3; }
  .glance-wide { grid-column: 1 / -1; }
  /* Value first on screen; label (dt) stays first in the markup. */
  .glance-item { display: flex; flex-direction: column; gap: 2px; }
  .glance dt { font-size: .875rem; line-height: 1.4; color: var(--color-steel); }
  .glance dd { margin: 0; }
  .glance-value { order: -1; font-size: 1.625rem; line-height: 1.2; font-weight: 600; letter-spacing: -.02em; font-stretch: 92%; }
  .glance-value-big { font-size: 2.75rem; line-height: 1; letter-spacing: -.03em; margin-bottom: 4px; color: var(--color-cobalt); }
  .glance-machines dt { color: var(--color-ink); font-weight: 600; }
  .glance-machines .glance-scale dt, .glance-machines .glance-years dt { color: var(--color-steel); font-weight: 400; }
  .glance-years { padding-bottom: 18px; border-bottom: 1px solid #D5DCE3; }
  .glance-detail { font-size: .875rem; line-height: 1.4; color: var(--color-steel); }
  @media (min-width: 768px) {
    .hero-title { max-width: none; }
  }
  /* Desktop: copy left, glance box right; the title shrinks with its column so it stays on one line. */
  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: minmax(0, 1.4fr) minmax(340px, 1fr); gap: 56px; }
    .hero-copy { container-type: inline-size; gap: 24px; }
    /* Desktop: larger portrait and name so the identity block balances the glance box. */
    .hero-id { gap: 28px; }
    .hero-portrait { width: 184px; height: 184px; border-radius: 18px; }
    .hero-id-text { gap: 8px; }
    .hero-name { font-size: 1.75rem; line-height: 1.2; letter-spacing: -.01em; font-stretch: 92%; }
    .hero-kicker { font-size: 1.0625rem; }
    .kicker-role { display: block; }
    .kicker-sep { display: none; }
    .hero-title { white-space: nowrap; font-size: min(4rem, 7.1cqi); }
    .glance { padding: 32px; gap: 24px; }
  }

  /* Sections */
  .section-block { padding-block: var(--section-space); }
  .section-ruled { border-top: 1px solid var(--color-line); }
  /* Assembly Automation Technologies sits on a drawing sheet: mist with the drawing grid. */
  .section-sheet { background-color: var(--color-mist); border-bottom: 1px solid var(--color-line); }
  .section-intro { margin-top: 16px; display: flex; flex-direction: column; gap: 10px; }
  .section-intro, .section-intro p { color: var(--color-body); }

  /* Six-to-eight phase stepper: native details, one open at a time, no script. */
  .steps { list-style: none; margin: 32px 0 0; padding: 0; max-width: 880px; }
  /* Desktop: the lifecycle uses the full width; the two introduction paragraphs sit side by side to keep lines readable. */
  @media (min-width: 1024px) {
    .intro-cols { max-width: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 48px; }
    .steps { max-width: none; }
    .phase-body .phase-lead { max-width: 80ch; }
  }
  .step { position: relative; padding-bottom: 14px; scroll-margin-top: 84px; }
  .step:not(:last-child)::before { content: ''; position: absolute; left: 16px; top: 50px; bottom: 0; width: 2px; border-radius: 2px; background: var(--color-line); transition: background-color var(--transition-duration); }
  .phase-summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 34px minmax(0, 1fr) 32px; gap: 14px; align-items: start; padding: 8px 0 4px; min-height: 44px; }
  .phase-summary::-webkit-details-marker { display: none; }
  .step-dot { width: 34px; height: 34px; box-sizing: border-box; border-radius: 999px; border: 1.5px solid #C9D2DB; background: var(--color-white); color: var(--color-steel); font-size: .8125rem; font-variant-numeric: tabular-nums; font-weight: 600; display: flex; align-items: center; justify-content: center; transition: background-color var(--transition-duration), color var(--transition-duration), border-color var(--transition-duration); }
  .phase-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; padding-top: 3px; }
  .phase-title { font-size: 1.1875rem; line-height: 1.35; font-weight: 600; letter-spacing: -.01em; color: var(--color-ink); transition: color var(--transition-duration); }
  .phase-line { color: var(--color-steel); font-size: 1rem; line-height: 1.55; }
  .phase-icon { width: 32px; height: 32px; border-radius: 999px; background: var(--color-mist); position: relative; transition: background-color var(--transition-duration); }
  .phase-icon::before, .phase-icon::after { content: ''; position: absolute; left: 9px; right: 9px; top: 15px; height: 2px; border-radius: 2px; background: var(--color-cobalt); transition: transform var(--transition-duration); }
  .phase-icon::after { transform: rotate(90deg); }
  .phase-summary:hover .phase-title { color: var(--color-cobalt); }
  .phase[open] .phase-icon { background: var(--color-cobalt-tint); }
  .phase[open] .phase-icon::after { transform: rotate(0deg); }
  .phase[open] .step-dot { background: var(--color-cobalt); border-color: var(--color-cobalt); color: var(--color-white); }
  /* Phases before the open one read as done. */
  .step:has(~ .step > details[open])::before { background: var(--color-cobalt); }
  .step:has(~ .step > details[open]) .step-dot { border-color: var(--color-cobalt); background: var(--color-cobalt-tint); color: var(--color-cobalt); }
  .phase-body { margin: 12px 0 6px 48px; padding: 18px; background: var(--color-cobalt-tint); border-radius: var(--radius-inner); display: grid; gap: 16px; }
  .phase-body p, .duty-list { color: var(--color-ink); }
  .phase-body .phase-lead { font-weight: 500; }
  .phase-body .body-label { font-size: .875rem; font-weight: 600; color: var(--color-cobalt); margin-bottom: 6px; }
  .duty-list { margin: 0; padding-left: 1.1em; list-style: disc; display: flex; flex-direction: column; gap: 6px; }
  .tag { white-space: nowrap; }
  .tag-sep { margin-inline: .2em; color: #8A96A3; }
  .duty-list li::marker { color: var(--color-cobalt); }
  @media (min-width: 768px) {
    .phase-body { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 20px 28px; padding: 24px; }
    .phase-lead { grid-column: 1 / -1; }
  }

  /* Track record */
  .track { margin-top: 32px; max-width: 880px; padding: 24px; border: 1px solid #D5DCE3; border-radius: var(--radius-panel); }
  /* Panel headings (Track record, Working Standards): one style. */
  .track-heading, .practice-heading { font-size: 1.375rem; line-height: 1.25; letter-spacing: -.01em; font-stretch: 92%; }
  .track-intro { margin-top: 8px; color: var(--color-body); max-width: 72ch; }
  .track-cols { display: grid; gap: 20px; margin-top: 16px; }
  .track-label { font-size: .875rem; line-height: 1.4; font-weight: 600; font-stretch: 100%; letter-spacing: 0; color: var(--color-cobalt); }
  .track-list { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .track-list li { display: flex; gap: 12px; align-items: baseline; }
  .track-count { flex-shrink: 0; min-width: 24px; font-size: 1.25rem; font-weight: 600; color: var(--color-cobalt); }
  @media (min-width: 768px) { .track, .practice { padding: 32px; } .track-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; } }
  @media (min-width: 1024px) {
    .track { max-width: none; }
    .track-intro { max-width: none; }
    /* Panels use their full width: no early-wrapping text beside empty space. */
    #machine .section-intro { max-width: none; }
    .practice .practice-text { max-width: none; }
  }

  /* Practice */
  .practice-wrap { padding-block: var(--section-space); }
  .practice { background: var(--color-cobalt-tint); }
  .practice { padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .practice-text { color: var(--color-body); max-width: 72ch; }
  .practice .chip-row { margin-top: 8px; }

  /* Experience */
  .role-list { list-style: none; margin: 16px 0 0; padding: 0; max-width: 880px; }
  .role { display: grid; gap: 4px 32px; padding: 20px 0; border-bottom: 1px solid var(--color-line); }
  .role:last-child { border-bottom: 0; }
  .role-dates { font-size: .875rem; color: var(--color-steel); padding-top: 3px; }
  .role-summary { margin-top: 6px; color: var(--color-body); }
  @media (min-width: 768px) { .role { grid-template-columns: 11rem minmax(0, 1fr); } }
  @media (min-width: 1024px) { .role-list { max-width: none; } }

  /* Skills */
  .skill-groups { display: flex; flex-direction: column; margin-top: 16px; }
  .skill-group { display: grid; gap: 10px 32px; padding: 18px 0; border-bottom: 1px solid var(--color-line); }
  .skill-group:last-child { border-bottom: 0; }
  @media (min-width: 768px) { .skill-group { grid-template-columns: 14rem minmax(0, 1fr); } }

  /* Education, publications, patent */
  .credentials-grid { display: grid; gap: 40px; }
  @media (min-width: 1024px) { .credentials-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; } }
  .record-list { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .record-title { font-weight: 600; color: var(--color-ink); }
  .record-link { display: inline; text-decoration-color: #C9D2DB; }
  .record-link:hover { color: var(--color-cobalt); text-decoration-color: currentColor; }
  .record-meta { font-size: .875rem; color: var(--color-steel); margin-top: 2px; }

  /* Contact */
  .contact-wrap { padding-bottom: var(--section-space); }
  .contact { padding: 28px; display: flex; flex-wrap: wrap; gap: 24px 48px; align-items: center; justify-content: space-between;
    background-color: var(--color-cobalt-deep); color: var(--color-white); --grid-minor: rgb(255 255 255 / .035); --grid-major: rgb(255 255 255 / .08); }
  .contact h2 { color: var(--color-white); }
  .contact-intro { margin-top: 14px; color: var(--color-cobalt-tint); }
  .contact :focus-visible { outline-color: var(--color-white); }
  .contact .action-link { background: var(--color-white); border-color: var(--color-white); color: var(--color-cobalt-deep); }
  .contact .action-link:hover { background: var(--color-cobalt-tint); border-color: var(--color-cobalt-tint); color: var(--color-cobalt-deep); }
  .contact .ghost-link { background: transparent; border-color: rgb(255 255 255 / .7); color: var(--color-white); }
  .contact .ghost-link:hover { background: rgb(255 255 255 / .1); color: var(--color-white); }
  /* Desktop contact: text across the panel, buttons stacked on the right. */
  @media (min-width: 1024px) {
    .contact { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 24px 56px; padding: 40px; }
    .contact .reading-width { max-width: none; }
    .contact .button-row { flex-direction: column; align-items: stretch; }
  }
</style>
