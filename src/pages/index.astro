---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptualSystem from '../components/illustrations/ConceptualSystem.astro';
import ContentCard from '../components/content/ContentCard.astro';
import EvidenceDisclosure from '../components/content/EvidenceDisclosure.astro';
import { identity, pillars, routeHref, sections } from '../lib/site';
---
<BaseLayout title={identity.name} description={identity.introduction} home>
  <section class="technical-surface section-space" aria-labelledby="hero-heading">
    <div class="page-container editorial-grid items-center" data-grid="responsive">
      <div class="span-two-thirds">
        <p class="technical-label mb-6">{identity.positioning}</p>
        <h1 id="hero-heading" class="hero-title max-w-[16ch]">{identity.headline[0]}<span class="mt-4 block text-jade">{identity.headline[1]}</span></h1>
        <p class="secondary-text reading-width mt-6">{identity.introduction}</p>
        <div class="flex flex-wrap gap-4 mt-8">
          <a href={routeHref('work')} class="action-link">Explore selected work <span aria-hidden="true">→</span></a>
          <a href={routeHref('about')} class="inline-flex min-h-11 items-center">Professional profile</a>
        </div>
      </div>
      <ConceptualSystem class="span-one-third"/>
    </div>
  </section>
  <section class="page-container section-space" aria-labelledby="pillars-title">
    <p class="technical-label mb-3">01 / Professional expertise</p>
    <h2 id="pillars-title">Four professional pillars.</h2>
    <div class="editorial-grid mt-8">
      {pillars.map((pillar,index)=><div class="span-half border-t border-structural pt-5 pb-4"><p class="technical-label mb-3">{String(index+1).padStart(2,'0')}</p><h3>{pillar}</h3></div>)}
    </div>
    <a class="inline-flex min-h-11 items-center mt-6" href={routeHref('expertise')}>Explore expertise →</a>
  </section>
  <section class="page-container pb-16" aria-labelledby="sections-title">
    <hr class="rule mb-12"/>
    <p class="technical-label mb-3">02 / Explore</p>
    <h2 id="sections-title">Portfolio sections.</h2>
    <div class="editorial-grid mt-8">
      {sections.map(s=><ContentCard class="span-half" title={s.title} description={s.description} route={s.slug}/>)}
    </div>
    <div class="mt-8"><EvidenceDisclosure kind="development"/></div>
  </section>
</BaseLayout>
