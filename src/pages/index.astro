---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { loadCatalog } from '../lib/content/catalog';
import { identity } from '../lib/site';
import { hero, atAGlance, process, phases, trackRecord, practice, experienceHeading, skills, contact, displayDate } from '../lib/portfolio';
import { approvedContact, approvedEmail, approvedResume } from '../lib/publication';
await loadCatalog();
const career = (await getCollection('career')).map(e => e.data).sort((a, b) => b.start.localeCompare(a.start));
const credentials = (await getCollection('credentials')).map(e => e.data)
  .sort((a, b) => (a.category === b.category ? b.issued.localeCompare(a.issued) : a.category === 'education' ? -1 : 1));
const publications = (await getCollection('publications')).map(e => e.data).sort((a, b) => a.year - b.year || a.id.localeCompare(b.id));
const patents = (await getCollection('patents')).map(e => e.data);
const emailAddress = approvedEmail?.href.replace(/^mailto:/i, '') ?? null;
---
<BaseLayout title={identity.name} description={identity.introduction} home>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="page-container hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">{hero.titleLine}</p>
        <h1 id="hero-heading" class="hero-title">{hero.headline}</h1>
        <p class="hero-intro">{hero.introduction}</p>
        <div class="button-row">
          {approvedContact && <a class="action-link" href={approvedContact.href} data-hero-contact>{approvedContact.label}</a>}
          {approvedEmail && <a class="ghost-link" href={approvedEmail.href} data-hero-email>{approvedEmail.label}</a>}
          {approvedResume && <a class="ghost-link" href={approvedResume.assetPath} download data-hero-resume>{approvedResume.label}</a>}
        </div>
      </div>
      <dl class="panel glance" aria-label="At a glance">
        {atAGlance.map(item => <div class="glance-item"><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <section id="process" class="section-block section-ruled" aria-labelledby="process-heading" data-reveal>
    <div class="page-container">
      <h2 id="process-heading">{process.heading}</h2>
      <p class="secondary-text reading-width section-intro">{process.introduction}</p>
      <ol class="steps" aria-label="Machine delivery phases">
        {phases.map((p, i) => (
          <li class="step" data-phase={p.id}>
            <details class="phase" name="phase" open={i === 0}>
              <summary class="phase-summary">
                <span class="step-dot" aria-hidden="true">{i + 1}</span>
                <span class="phase-text">
                  <span class="phase-title">{p.title}</span>
                  <span class="phase-line">{p.summary}</span>
                </span>
                <span class="phase-icon" aria-hidden="true"></span>
              </summary>
              <div class="phase-body">
                <div><p class="body-label">What I do</p><p>{p.role}</p></div>
                <div><p class="body-label">Deliverables</p><p>{p.deliver}</p></div>
              </div>
            </details>
          </li>
        ))}
      </ol>

      <div class="track" data-track-record>
        <h3 id="track-heading" class="track-heading">{trackRecord.heading}</h3>
        <div class="track-cols">
          <div>
            <h4 class="track-label">Completed</h4>
            <ul class="track-list">
              {trackRecord.completed.map(t => <li><span class="track-count">{t.count}</span><span>{t.item}</span></li>)}
            </ul>
          </div>
          <div>
            <h4 class="track-label">In progress</h4>
            <ul class="track-list">
              {trackRecord.inProgress.map(t => <li><span class="track-count">{t.count}</span><span>{t.item}</span></li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="page-container practice-wrap" aria-labelledby="practice-heading" data-reveal>
    <div class="panel practice">
      <h2 id="practice-heading" class="practice-heading">{practice.label}</h2>
      <p class="practice-text">{practice.statement}</p>
      <p class="practice-text">{practice.international}</p>
      <ul class="chip-row" aria-label="Standards and practices">
        {practice.labels.map(label => <li class="chip chip-light">{label}</li>)}
      </ul>
    </div>
  </section>

  <section id="experience" class="section-block section-ruled" aria-labelledby="experience-heading" data-reveal>
    <div class="page-container">
      <h2 id="experience-heading">{experienceHeading}</h2>
      <ol class="role-list">
        {career.map(role => (
          <li class="role" data-record-id={role.id}>
            <p class="role-dates">{displayDate(role.start)} – {role.end ? displayDate(role.end) : 'now'}</p>
            <div>
              <h3>{role.role}</h3>
              <p class="role-summary">{role.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="skills" class="section-block section-ruled" aria-labelledby="skills-heading" data-reveal>
    <div class="page-container">
      <h2 id="skills-heading">{skills.heading}</h2>
      <div class="skill-groups">
        {skills.groups.map(group => (
          <div class="skill-group" data-skill-group={group.group}>
            <h3>{group.group}</h3>
            <ul class="chip-row" aria-label={group.group}>
              {group.items.map(item => <li class="chip">{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="publications" class="section-block section-ruled" aria-labelledby="publications-heading" data-reveal>
    <div class="page-container credentials-grid">
      <div>
        <h2 class="subhead" id="education-heading">Education and certifications</h2>
        <ul class="record-list" aria-labelledby="education-heading">
          {credentials.map(c => (
            <li data-credential-id={c.id}>
              <p class="record-title">{c.title}</p>
              <p class="record-meta">{c.issuer} · {c.issued}</p>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="subhead" id="publications-heading">Publications and patent</h2>
        <ol class="record-list">
          {publications.map(p => (
            <li data-publication-id={p.id}>
              <a class="record-title record-link" href={'https://doi.org/' + p.doi}>{p.title}</a>
              <p class="record-meta">{p.venue} · {p.year}{p.authorship === 'first-author' ? ' · first author' : ''}</p>
            </li>
          ))}
          {patents.map(p => (
            <li data-patent-id={p.id}>
              <a class="record-title record-link" href={'https://patents.google.com/patent/' + p.patentNumber}>{p.title}</a>
              <p class="record-meta">{p.patentNumber.replace(/^US(\d+)B(\d)$/, 'US $1 B$2')} · granted patent · co-inventor</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section id="contact" class="page-container contact-wrap" aria-labelledby="contact-heading">
    <div class="panel contact">
      <div class="reading-width">
        <h2 id="contact-heading">{contact.heading}</h2>
        <p class="contact-intro">{contact.introduction}</p>
      </div>
      <div class="button-row">
        {approvedContact && <a class="action-link" href={approvedContact.href} data-approved-contact-link>{approvedContact.label}</a>}
        {approvedEmail && emailAddress && <a class="ghost-link" href={approvedEmail.href} data-approved-email-link>{emailAddress}</a>}
        {approvedResume && <a class="ghost-link" href={approvedResume.assetPath} download data-approved-resume-link>{approvedResume.label}</a>}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero { padding-block: clamp(40px, 7vw, 88px) clamp(40px, 6vw, 72px); }
  .hero-grid { display: grid; gap: 36px; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .hero-kicker { color: var(--color-steel); font-size: .9375rem; line-height: 1.5; }
  .hero-title { max-width: 15ch; }
  .hero-intro { color: var(--color-body); font-size: clamp(1.0625rem, 1rem + .3vw, 1.25rem); max-width: 56ch; }
  .hero-copy .button-row { margin-top: 8px; }
  .glance { margin: 0; padding: 22px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 18px; }
  .glance-item { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 2px; }
  .glance dt { font-size: .875rem; line-height: 1.4; color: var(--color-steel); }
  .glance dd { margin: 0; font-size: 1.625rem; line-height: 1.2; font-weight: 600; letter-spacing: -.02em; font-stretch: 92%; }
  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: minmax(0, 1.4fr) minmax(340px, 1fr); gap: 56px; }
    .glance { padding: 28px; gap: 26px 22px; }
  }

  /* Sections */
  .section-block { padding-block: var(--section-space); }
  .section-ruled { border-top: 1px solid var(--color-line); }
  .section-intro { margin-top: 14px; }

  /* Six-to-eight phase stepper: native details, one open at a time, no script. */
  .steps { list-style: none; margin: 32px 0 0; padding: 0; max-width: 880px; }
  .step { position: relative; padding-bottom: 14px; }
  .step:not(:last-child)::before { content: ''; position: absolute; left: 16px; top: 50px; bottom: 0; width: 2px; border-radius: 2px; background: var(--color-line); transition: background-color var(--transition-duration); }
  .phase-summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 34px minmax(0, 1fr) 32px; gap: 14px; align-items: start; padding: 8px 0 4px; min-height: 44px; }
  .phase-summary::-webkit-details-marker { display: none; }
  .step-dot { width: 34px; height: 34px; box-sizing: border-box; border-radius: 999px; border: 1.5px solid #C9D2DB; background: var(--color-white); color: var(--color-steel); font-size: .8125rem; font-weight: 600; display: flex; align-items: center; justify-content: center; transition: background-color var(--transition-duration), color var(--transition-duration), border-color var(--transition-duration); }
  .phase-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; padding-top: 3px; }
  .phase-title { font-size: 1.1875rem; line-height: 1.35; font-weight: 600; letter-spacing: -.01em; color: var(--color-ink); transition: color var(--transition-duration); }
  .phase-line { color: var(--color-steel); font-size: 1rem; line-height: 1.55; }
  .phase-icon { width: 32px; height: 32px; border-radius: 999px; background: var(--color-mist); position: relative; transition: background-color var(--transition-duration); }
  .phase-icon::before, .phase-icon::after { content: ''; position: absolute; left: 9px; right: 9px; top: 15px; height: 2px; border-radius: 2px; background: var(--color-cobalt); transition: transform var(--transition-duration); }
  .phase-icon::after { transform: rotate(90deg); }
  .phase-summary:hover .phase-title { color: var(--color-cobalt); }
  .phase[open] .phase-icon { background: var(--color-cobalt-tint); }
  .phase[open] .phase-icon::after { transform: rotate(0deg); }
  .phase[open] .step-dot { background: var(--color-cobalt); border-color: var(--color-cobalt); color: var(--color-white); }
  /* Phases before the open one read as done. */
  .step:has(~ .step > details[open])::before { background: var(--color-cobalt); }
  .step:has(~ .step > details[open]) .step-dot { border-color: var(--color-cobalt); background: var(--color-cobalt-tint); color: var(--color-cobalt); }
  .phase-body { margin: 12px 0 6px 48px; padding: 18px; background: var(--color-cobalt-tint); border-radius: var(--radius-inner); display: grid; gap: 16px; }
  .phase-body p { color: var(--color-ink); }
  .phase-body .body-label { font-size: .875rem; font-weight: 600; color: var(--color-cobalt); margin-bottom: 6px; }
  @media (min-width: 768px) {
    .phase-body { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 28px; padding: 22px 24px; }
  }

  /* Track record */
  .track { margin-top: 28px; max-width: 880px; padding: 24px 22px; border: 1px solid #D5DCE3; border-radius: var(--radius-panel); }
  .track-heading { font-size: 1.375rem; font-stretch: 92%; }
  .track-cols { display: grid; gap: 20px; margin-top: 16px; }
  .track-label { font-size: .9375rem; line-height: 1.4; font-weight: 600; font-stretch: 100%; letter-spacing: 0; color: var(--color-cobalt); }
  .track-list { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .track-list li { display: flex; gap: 12px; align-items: baseline; }
  .track-count { flex-shrink: 0; min-width: 24px; font-size: 1.25rem; font-weight: 600; }
  @media (min-width: 768px) { .track { padding: 28px; } .track-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; } }

  /* Practice */
  .practice-wrap { padding-bottom: var(--section-space); }
  .practice { padding: clamp(24px, 4vw, 36px); display: flex; flex-direction: column; gap: 12px; }
  .practice-heading { font-size: 1.375rem; }
  .practice-text { color: var(--color-body); max-width: 72ch; }
  .practice .chip-row { margin-top: 8px; }

  /* Experience */
  .role-list { list-style: none; margin: 16px 0 0; padding: 0; max-width: 880px; }
  .role { display: grid; gap: 4px 32px; padding: 20px 0; border-bottom: 1px solid var(--color-line); }
  .role:last-child { border-bottom: 0; }
  .role-dates { font-size: .875rem; color: var(--color-steel); padding-top: 3px; }
  .role-summary { margin-top: 6px; color: var(--color-body); }
  @media (min-width: 768px) { .role { grid-template-columns: 11rem minmax(0, 1fr); } }

  /* Skills */
  .skill-groups { display: flex; flex-direction: column; margin-top: 16px; }
  .skill-group { display: grid; gap: 10px 32px; padding: 18px 0; border-bottom: 1px solid var(--color-line); }
  .skill-group:last-child { border-bottom: 0; }
  @media (min-width: 768px) { .skill-group { grid-template-columns: 14rem minmax(0, 1fr); } }

  /* Education, publications, patent */
  .credentials-grid { display: grid; gap: 40px; }
  @media (min-width: 1024px) { .credentials-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 56px; } }
  .subhead { font-size: 1.375rem; }
  .record-list { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .record-title { font-weight: 600; color: var(--color-ink); }
  .record-link { display: inline; text-decoration-color: #C9D2DB; }
  .record-link:hover { color: var(--color-cobalt); text-decoration-color: currentColor; }
  .record-meta { font-size: .875rem; color: var(--color-steel); margin-top: 2px; }

  /* Contact */
  .contact-wrap { padding-bottom: var(--section-space); }
  .contact { padding: clamp(28px, 5vw, 48px); display: flex; flex-wrap: wrap; gap: 24px 48px; align-items: center; justify-content: space-between; }
  .contact-intro { margin-top: 14px; color: var(--color-body); }
</style>
