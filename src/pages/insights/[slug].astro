---
import {getCollection,type CollectionEntry} from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import EvidenceLabel from '../../components/content/EvidenceLabel.astro';
import EvidenceDisclosure from '../../components/content/EvidenceDisclosure.astro';
import RelatedEvidence from '../../components/content/RelatedEvidence.astro';
import {loadCatalog,related} from '../../lib/content/catalog';
export const getStaticPaths=(async()=> (await getCollection('insights')).map(entry=>({params:{slug:entry.data.slug},props:{entry}}))) satisfies GetStaticPaths;
interface Props{entry:CollectionEntry<'insights'>}
const {entry}=Astro.props;const d=entry.data;const catalog=await loadCatalog();
---
<ArticleLayout title={d.title} description={d.summary} route={'insights/'+d.slug} eyebrow={'Engineering insights / '+d.id}>
  <EvidenceLabel type={d.evidenceType}/>
  {d.evidenceType==='illustrative-simulation'&&<EvidenceDisclosure kind="simulated"/>}
  {d.evidenceType==='independent-demonstration'&&<EvidenceDisclosure kind="independent"/>}
  {d.body.split(/\n\s*\n/).map(p=><p class="whitespace-pre-line">{p}</p>)}
  {d.references.length>0 && <section aria-label="Public references"><h2>References</h2><ul>{d.references.map(ref=><li><a class="inline-flex min-h-11 items-center" href={ref.url}>{ref.label}</a></li>)}</ul></section>}
  <RelatedEvidence entries={related(catalog,d)}/>
</ArticleLayout>
