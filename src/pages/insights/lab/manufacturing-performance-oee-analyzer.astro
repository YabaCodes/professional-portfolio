---
import {getCollection} from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import OeeAnalyzer from '../../../components/content/OeeAnalyzer.astro';
import EvidenceDisclosure from '../../../components/content/EvidenceDisclosure.astro';
import {loadCatalog} from '../../../lib/content/catalog';
import {routeHref} from '../../../lib/site';
const catalog=await loadCatalog();
const entry=(await getCollection('demonstrations')).find(item=>item.data.id==='EL-001');
if(!entry)throw new Error('EL-001 record missing');
const d=entry.data;
const sections=[{id:'analyzer',label:'Interactive analyzer'},{id:'model',label:'Engineering method'},{id:'assumptions',label:'Assumptions'},{id:'limitations',label:'Limitations'},{id:'sources',label:'Evidence & connections'}];
---
<ArticleLayout title={d.title} description={d.summary} route={'insights/lab/'+d.slug} eyebrow="Engineering Lab / EL-001 / Independent demonstration" headings={sections}>
 <a href={routeHref('insights/lab')} class="inline-flex min-h-11 items-center">← All Engineering Lab tools</a>
 <p class="mt-4">{d.summary}</p>
 <EvidenceDisclosure kind="independent"/>
 <div class="mt-4"><EvidenceDisclosure kind="simulated"/></div>
 <p class="technical-caption mt-4">Data provenance: predefined synthetic scenarios or visitor-entered hypothetical inputs, processed locally in this browser. No employer datasets, analytics service, storage, or network submission is used.</p>
 <div class="mt-8"><OeeAnalyzer/></div>
 <section class="border-t border-structural pt-5 mt-8" aria-labelledby="model">
  <h2 id="model">Engineering method</h2>
  <p>{d.method}</p>
  <ul class="list-disc pl-5 grid gap-2 text-sm" aria-label="OEE definitions">
   <li><strong>Availability:</strong> operating time ÷ planned production time</li>
   <li><strong>Performance:</strong> ideal cycle time × total units ÷ operating time, where defined</li>
   <li><strong>Quality:</strong> good units ÷ total units, where defined</li>
   <li><strong>OEE:</strong> ideal cycle time × good units ÷ planned production time</li>
  </ul>
  <p class="technical-caption mt-4">The chart partitions planned minutes into downtime, performance time, quality-equivalent loss time and effective good production. Small floating-point roundoff is normalized within a strict tolerance; physically inconsistent larger excesses are rejected.</p>
 </section>
 <section class="border-t border-structural pt-5 mt-8" aria-labelledby="assumptions">
  <h2 id="assumptions">Inputs & assumptions</h2>
  <p class="technical-label">Inputs</p>
  <ul class="list-disc pl-5 grid gap-2">{d.inputs.map(x=><li>{x}</li>)}</ul>
  <p class="technical-label mt-5">Model assumptions</p>
  <ul class="list-disc pl-5 grid gap-2">{d.assumptions.map(x=><li>{x}</li>)}</ul>
 </section>
 <section class="border-t border-structural pt-5 mt-8" aria-labelledby="limitations">
  <h2 id="limitations">Limitations</h2>
  <ul class="list-disc pl-5 grid gap-2">{d.limitations.map(x=><li>{x}</li>)}</ul>
  <p class="mt-4">The dominant loss is an investigation starting point. It is not a diagnosis of mechanical, automation, feeding, quality or other equipment causes.</p>
 </section>
 <section class="border-t border-structural pt-5 mt-8" aria-labelledby="sources">
  <h2 id="sources">Evidence & connections</h2>
  <p>This original calculation model is an independent technical demonstration, not a measured company project outcome. Its synthetic outputs are distinct from professional experience statements.</p>
  <div class="flex flex-wrap gap-4 mt-4">
   <a class="inline-flex min-h-11 items-center" href={routeHref('work/engineering-for-manufacturing-performance')}>Related manufacturing performance case study →</a>
   <a class="inline-flex min-h-11 items-center" href={routeHref('expertise')+'#comp-010'}>Manufacturing Performance & OEE competency →</a>
  </div>
 </section>
</ArticleLayout>
