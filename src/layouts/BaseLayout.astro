---
import '@fontsource-variable/manrope';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Header from '../components/shell/Header.astro';
import Footer from '../components/shell/Footer.astro';
import { identity, sitePath, routeHref } from '../lib/site';
import release from '../../config/release.json';
interface Props {
  title: string;
  description: string;
  route?: string;
  home?: boolean;
}
const { title, description, route = '', home = false } = Astro.props;
const documentTitle = home ? identity.name + ' — ' + identity.positioning : title + ' | ' + identity.name;
const canonicalUrl = Astro.site ? new URL(routeHref(route), Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!release.publicationEnabled && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101E2A" />
    <title>{documentTitle}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip-link action-link" href="#main-content">Skip to content</a>
    <Header current={route} />
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
