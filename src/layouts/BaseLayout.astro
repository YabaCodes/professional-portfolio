---
import '@fontsource-variable/instrument-sans/wdth.css';
import '../styles/global.css';
import Header from '../components/shell/Header.astro';
import Footer from '../components/shell/Footer.astro';
import { identity, sitePath, routeHref } from '../lib/site';
import { hero } from '../lib/portfolio';
import release from '../../config/release.json';
interface Props {
  title: string;
  description: string;
  route?: string;
  home?: boolean;
}
const { title, description, route = '', home = false } = Astro.props;
const documentTitle = home ? identity.name + ' — ' + identity.positioning : title + ' | ' + identity.name;
const canonicalUrl = Astro.site ? new URL(routeHref(route), Astro.site).href : undefined;
/** Link preview for LinkedIn and messaging apps: public/link-preview.jpg (npm run generate:link-preview). */
const previewImage = Astro.site ? new URL(sitePath('link-preview.jpg'), Astro.site).href : undefined;
const previewAlt = identity.name + ', ' + hero.titleLine.replace(/\u00A0/g, ' ') + ': ' + hero.headline;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!release.publicationEnabled && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <title>{documentTitle}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {previewImage && <meta property="og:image" content={previewImage} />}
    {previewImage && <meta property="og:image:type" content="image/jpeg" />}
    {previewImage && <meta property="og:image:width" content="1200" />}
    {previewImage && <meta property="og:image:height" content="630" />}
    {previewImage && <meta property="og:image:alt" content={previewAlt} />}
    <meta name="twitter:card" content={previewImage ? 'summary_large_image' : 'summary'} />
    {previewImage && <meta name="twitter:image" content={previewImage} />}
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip-link action-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
